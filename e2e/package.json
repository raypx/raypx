{
  "name": "@raypx/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "capture:product": "bun run capture-product.ts",
    "e2e:web": "playwright test --config=playwright.web.config.ts",
    "e2e:desktop": "playwright test --config=playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "catalog:tooling",
    "@raypx/client": "workspace:*",
    "@raypx/db": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:backend",
    "typescript": "catalog:tooling"
  }
}
