{
  "name": "@raypx/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "e2e": "raypx-dev browser:run",
    "e2e:live": "bun --bun playwright test --config playwright.live.config.ts",
    "e2e:web": "raypx-dev browser:run",
    "e2e:desktop": "raypx-dev browser:run",
    "e2e:smoke": "raypx-dev browser:run",
    "e2e:visual": "raypx-dev browser:run"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@types/bun": "catalog:dev"
  },
  "raypx": {
    "kind": "tooling",
    "target": "bun"
  }
}
