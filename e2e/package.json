{
  "name": "@raypx/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./tests/helpers/testing.ts",
    "./journeys/*": "./tests/journeys/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "e2e": "raypx-dev e2e",
    "e2e:devtools": "bun --bun playwright test --config playwright.devtools.config.ts",
    "e2e:web": "raypx-dev e2e --web",
    "e2e:desktop": "raypx-dev e2e --desktop",
    "e2e:smoke": "raypx-dev e2e --smoke",
    "e2e:visual": "raypx-dev e2e --visual"
  },
  "dependencies": {
    "@playwright/test": "catalog:dev",
    "@raypx/account": "workspace:*",
    "@raypx/client": "workspace:*"
  },
  "devDependencies": {
    "@raypx/dev-cli": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev"
  }
}
