# Copy to .env or inject through Dokploy/CI. Keep real values untracked.
COMPOSE_PROJECT_NAME=raypx-app
APP_HOST=app.example.com
# Image tags use <compose-project>-<release>; use the same project name as Dokploy.
RAYPX_RELEASE=replace-with-source-version
POSTGRES_DB=raypx
# Required 64 hexadecimal characters from the verified postgres:17-alpine manifest.
POSTGRES_IMAGE_DIGEST=
POSTGRES_USER=raypx
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_USER=raypx_runtime
POSTGRES_RUNTIME_PASSWORD=
# Leave empty for a project-scoped volume; set only when reusing known storage.
POSTGRES_VOLUME_NAME=
AUTH_SECRET=
# Independent of AUTH_SECRET: encrypts stored provider credentials and signs instances.
APP_KEY=
# Optional backend model directory and protected credential map (JSON).
# See docs/architecture/execution.md; both may stay empty to disable model access.
AGENT_MODELS=[]
AGENT_MODEL_CREDENTIALS={}
APPROVAL_DEFAULT_MODE=ask
APPROVAL_REQUEST_TTL_MS=600000
# Optional inbound email: configure both; relay token is dedicated and sent only to API.
ROUTINE_EMAIL_RELAY_TOKEN=
ROUTINE_EMAIL_DOMAIN=
ADMIN_EMAILS=
# Explicitly seed missing provider settings during db:migrate.
DB_MIGRATE_IMPORT_CONFIG=false
RESEND_API_KEY=
MAIL_FROM=
MAIL_DEFAULT_LOCALE=en
# Optional parent cookie domain; leave empty for the shared application origin.
# Set this to the shared parent when Web and API use sibling hosts.
AUTH_PASSKEY_RP_ID=
AUTH_CHECK_COMPROMISED_PASSWORDS=false
# Set both to protect requests for email sign-in codes.
AUTH_TURNSTILE_SITE_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_DOMAIN=
# Optional cache and retained device Relay broker. Durable Runs use PostgreSQL only.
REDIS_URL=
# Optional inputs for db:migrate. Supply endpoint, bucket and both keys together.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional server analytics; never pass these as build arguments.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
JOBS_ENABLED=true
# API startup applies pending migrations by default; false skips only this startup step.
DATABASE_MIGRATE_ON_START=false
AUTH_IP_HEADERS=x-forwarded-for
# Exact Traefik /32 or /128 address; add trusted edge ranges when applicable.
# Never trust the complete shared Docker subnet.
AUTH_TRUSTED_PROXIES=
# Empty selects <COMPOSE_PROJECT_NAME>-ingress; attach only Traefik/Web/API.
TRAEFIK_NETWORK=
TRAEFIK_CERT_RESOLVER=letsencrypt
POSTGRES_MEMORY=512m
POSTGRES_CPUS=1
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=128MB
MIGRATE_MEMORY=512m
MIGRATE_CPUS=0.5
API_MEMORY=768m
API_CPUS=1
RELAY_MEMORY=512m
RELAY_CPUS=0.75
WEB_MEMORY=512m
WEB_CPUS=0.75
# Build settings are read by build.sh; limits apply when creating the builder.
RAYPX_BUILD_BUILDER=raypx-builder
BUILD_MEMORY=3g
BUILD_MEMORY_SWAP=4g
# 100000 = one CPU, with the fixed 100000 microsecond period.
BUILD_CPU_QUOTA=200000

# Optional social login: configure both values for each provider. Secrets stay on API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# all runs API, worker recovery and Relay in one process. Split roles use the same image.
SERVER_ROLE=all
# Lease heartbeat must be at most half the lease duration.
RUN_RECOVERY_INTERVAL_MS=5000
RUN_LEASE_MS=15000
RUN_HEARTBEAT_MS=5000
RUN_ATTEMPT_TIMEOUT_MS=300000
RUN_BACKUP_MARGIN_MS=30000
# Optional split-worker container resources.
WORKER_MEMORY=768m
WORKER_CPUS=1

# Optional computers. Everything else starts with none; the backend never receives an Engine socket.
COMPUTER_PROVIDER=none
SANDBOX_SUPERVISOR_URL=
SANDBOX_SUPERVISOR_TOKEN=
COMPUTERS_PER_SPACE=1
COMPUTERS_PER_MEMBER=10
# Opt-in Compose sandbox profile. Supply the verified oven/bun manifest digest
# to build the supervisor with `docker compose --profile sandbox build sandbox`.
# The prepared computer image is built separately; provision never pulls/builds.
BUN_IMAGE_DIGEST=
# Set supervisor URL to http://sandbox:4020 and supply a new independent 32+ character token.
SANDBOX_COMPUTER_IMAGE=
# Absolute host socket path, including a rootless/Colima socket when applicable.
# Inside the supervisor it is always /var/run/docker.sock; never pass it to API.
SANDBOX_ENGINE_SOCKET=/var/run/docker.sock
SANDBOX_LISTEN_ADDRESS=172.30.40.2
SANDBOX_CONTROL_SUBNET=172.30.40.0/24
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_RESTRICTED_EGRESS=false
# Assert only after applying and checking the host rules for the deterministic computer bridge.
SANDBOX_HOST_RULES_APPLIED=false
