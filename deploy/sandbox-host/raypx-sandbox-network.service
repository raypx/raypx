[Unit]
Description=Raypx Engine-host network policy
Requires=docker.service
After=docker.service
Before=raypx-sandbox.service

[Service]
Type=simple
User=root
Group=raypx-sandbox
ExecStart=/usr/bin/python3 -I /opt/raypx-sandbox/current/host-network.py serve /var/lib/raypx-sandbox-network /run/raypx-sandbox-network/control.sock raypx-sandbox
Restart=on-failure
RestartSec=3
StateDirectory=raypx-sandbox-network
StateDirectoryMode=0700
RuntimeDirectory=raypx-sandbox-network
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
MemoryMax=64M
TasksMax=32
LimitNOFILE=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
