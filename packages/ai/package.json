{
  "name": "@raypx/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "node",
    "entryTargets": {
      "./config": "universal"
    },
    "sourceTargets": {
      "src/config.ts": "universal",
      "src/errors.ts": "universal"
    }
  }
}
