{
  "name": "@raypx/instances",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./crypto": "./src/crypto.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./crypto": "node",
      "./server": "node"
    },
    "sourceTargets": {
      "src/crypto.ts": "node",
      "src/*.test.ts": "node",
      "src/server.ts": "node",
      "src/server/**": "node"
    }
  }
}
