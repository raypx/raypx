{
  "name": "@raypx/dev-cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "raypx-dev": "./bin/raypx-dev.mjs"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vitest run tests/integration",
    "test:inventory": "bun src/cli.ts test inventory",
    "test:backends": "bun src/cli.ts test backends",
    "test:sandbox": "bun src/cli.ts test sandbox"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:dev",
    "@posthog/cli": "catalog:dev",
    "@raypx/runtime-node": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "oxc-parser": "catalog:dev"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
