{
  "name": "@raypx/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./hooks": "./src/hooks.ts",
    "./policy": "./src/policy.ts",
    "./types": "./src/types.ts",
    "./access": "./src/access.ts",
    "./client/styles.css": "./src/client/styles.css",
    "./origins": "./src/origins.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:component": "bun --bun vp test --run --project component",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vp test --run --coverage"
  },
  "dependencies": {
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/ui": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./server": "node",
      "./client": "browser",
      "./hooks": "universal",
      "./client/styles.css": "browser",
      "./origins": "universal"
    },
    "sourceTargets": {
      "src/server.ts": "node",
      "src/client.ts": "browser",
      "src/client/**": "browser",
      "src/hooks.ts": "universal"
    }
  }
}
