{
  "name": "@raypx/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./native": "./src/native.ts",
    "./hooks": "./src/hooks.ts",
    "./types": "./src/types.ts",
    "./client/styles.css": "./src/client/styles.css"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*",
    "better-auth": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@voidmix/tsconfig": "catalog:dev",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./server": "node",
      "./client": "browser",
      "./native": "native",
      "./hooks": "universal",
      "./client/styles.css": "browser"
    },
    "sourceTargets": {
      "src/server.ts": "node",
      "src/client.ts": "browser",
      "src/client/**": "browser",
      "src/native.ts": "native",
      "src/hooks.ts": "universal"
    }
  }
}
