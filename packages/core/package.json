{
  "name": "@raypx/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./spaces": "./src/spaces.ts",
    "./agents": "./src/agents.ts",
    "./auth": "./src/auth.ts",
    "./agent-runs": "./src/agent-runs.ts",
    "./tasks": "./src/tasks.ts",
    "./activity": "./src/activity.ts",
    "./task-text": "./src/task-text.ts",
    "./permissions": "./src/permissions.ts",
    "./memory": "./src/memory.ts",
    "./jobs": "./src/jobs.ts",
    "./conversation": "./src/conversation.ts",
    "./computers": "./src/computers.ts",
    "./approvals": "./src/approvals.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "croner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
