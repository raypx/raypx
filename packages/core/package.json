{
  "name": "@raypx/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./auth": "./src/auth.ts",
    "./agent-runs": "./src/agent-runs.ts",
    "./tasks": "./src/tasks.ts",
    "./activity": "./src/activity.ts",
    "./task-text": "./src/task-text.ts",
    "./permissions": "./src/permissions.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "vp test --run --coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "universal"
  }
}
