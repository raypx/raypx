{
  "name": "@raypx/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./s3": "./src/s3.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vp test --run --coverage"
  },
  "dependencies": {
    "aws4fetch": "catalog:",
    "unstorage": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "universal"
  }
}
