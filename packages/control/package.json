{
  "name": "@raypx/control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/service.ts",
    "./postgres": "./src/postgres.ts",
    "./relay": "./src/relay/index.ts",
    "./testing": "./tests/helpers/control.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\""
  },
  "dependencies": {
    "@raypx/auth": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/memory": "workspace:*",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "node"
  }
}
