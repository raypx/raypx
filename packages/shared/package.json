{
  "name": "@raypx/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./env": {
      "types": "./dist/env/index.d.mts",
      "import": "./dist/env/index.mjs"
    },
    "./env/runtime": {
      "types": "./dist/env/runtime.d.mts",
      "import": "./dist/env/runtime.mjs"
    },
    "./logger": {
      "types": "./dist/logger/index.d.mts",
      "import": "./dist/logger/index.mjs"
    },
    "./logger/client": {
      "types": "./dist/logger/client.d.mts",
      "import": "./dist/logger/client.mjs"
    },
    "./logger/env": {
      "types": "./dist/logger/env.d.mts",
      "import": "./dist/logger/env.mjs"
    },
    "./logger/hono": {
      "types": "./dist/logger/hono.d.mts",
      "import": "./dist/logger/hono.mjs"
    },
    "./logger/orpc": {
      "types": "./dist/logger/orpc.d.mts",
      "import": "./dist/logger/orpc.mjs"
    },
    "./logger/vite": {
      "types": "./dist/logger/vite.d.mts",
      "import": "./dist/logger/vite.mjs"
    }
  },
  "scripts": {
    "check": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "bun --bun vp pack",
    "dev": "bun --bun vp pack --watch"
  },
  "dependencies": {
    "@raypx/env": "catalog:",
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:tooling",
    "hono": "catalog:backend",
    "vite": "catalog:tooling"
  },
  "peerDependencies": {
    "@orpc/server": "*",
    "hono": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
