{
  "name": "@raypx/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests",
    "test:coverage": "bun --bun vp test --run --coverage",
    "generate": "bun --bun drizzle-kit generate --config drizzle.config.ts",
    "migrate": "bun src/commands.ts migrate",
    "studio": "bun --bun drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@raypx/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "drizzle-kit": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "node"
  }
}
