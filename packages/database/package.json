{
  "name": "@raypx/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vitest run --coverage",
    "generate": "bun --bun raypx-drizzle-kit generate --config drizzle.config.ts",
    "studio": "bun --bun raypx-drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@raypx/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@raypx/drizzle-kit": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
