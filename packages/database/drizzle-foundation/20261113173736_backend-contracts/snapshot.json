    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "model_connections",
        "name": "model_connections_protocol_check",
        "value": "(\"kind\" = 'compatible' and \"base_url\" is not null and \"api\" in ('anthropic-messages', 'openai-completions', 'openai-responses')) or (\"kind\" <> 'compatible' and \"base_url\" is null and \"api\" is null)",
        "entityType": "checks"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"conversation_events\",\"conversation_events_kind_check\"]",
      "set": {
        "value": "\"kind\" in ('message.created', 'run.state', 'reply.segment', 'computer.state', 'card.created', 'card.resolved', 'tool.started', 'tool.finished')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"conversation_events\",\"conversation_events_payload_check\"]",
      "set": {
        "value": "(\n      (\"kind\" = 'message.created' and \"message_id\" is not null and \"run_id\" is null and \"segment_id\" is null and \"data\" is null and \"computer_id\" is null and \"request_id\" is null) or\n      (\"kind\" = 'run.state' and \"message_id\" is null and \"run_id\" is not null and \"segment_id\" is null and \"data\" is not null and \"computer_id\" is null and \"request_id\" is null) or\n      (\"kind\" = 'reply.segment' and \"message_id\" is null and \"run_id\" is not null and \"segment_id\" is not null and \"data\" is null and \"computer_id\" is null and \"request_id\" is null) or\n      (\"kind\" = 'computer.state' and \"message_id\" is null and \"run_id\" is null and \"segment_id\" is null and \"computer_id\" is not null and \"data\" is not null and \"request_id\" is null) or\n      (\"kind\" in ('tool.started', 'tool.finished') and \"message_id\" is null and \"run_id\" is not null and \"segment_id\" is null and \"computer_id\" is null and \"request_id\" is null and \"data\" is not null) or\n      (\"kind\" in ('card.created', 'card.resolved') and \"message_id\" is null and \"run_id\" is not null and \"segment_id\" is null and \"computer_id\" is null and \"request_id\" is not null and \"data\" is not null)\n    )"
      }
    }
