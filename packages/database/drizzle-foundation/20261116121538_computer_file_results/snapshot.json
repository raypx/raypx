    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "conversation_tool_calls",
        "name": "conversation_tool_calls_file_result_check",
        "value": "\"file_result\" is null or (\n        \"finished_at\" is not null and \"outcome\" is not distinct from 'succeeded'\n        and jsonb_typeof(\"file_result\") = 'object'\n        and octet_length(\"file_result\"::text) <= 16384\n        and coalesce(\n          (\"tool_name\" = 'computer_search_files' and \"file_result\"->>'kind' = 'search')\n          or (\"tool_name\" = 'computer_edit_file' and \"file_result\"->>'kind' = 'edit'),\n          false\n        )\n      )",
        "entityType": "checks"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"approval_requests\",\"approval_requests_tool_check\"]",
      "set": {
        "value": "(\"tool_name\" in ('computer_list_files', 'computer_read_file', 'computer_search_files', 'computer_write_file', 'computer_edit_file', 'computer_run_command', 'computer_screenshot', 'computer_pointer', 'computer_keyboard', 'agent_memory_save', 'agent_memory_update', 'agent_page_create', 'agent_page_update', 'agent_page_read', 'agent_skill_load', 'agent_skill_save', 'web_search', 'web_read', 'weather_forecast') or (\"tool_name\" ~ '^mcp_[a-zA-Z0-9_-]+__[a-zA-Z0-9_-]+$' or \"tool_name\" ~ '^openapi_[a-f0-9]{32}__[a-zA-Z0-9_-]{1,64}$') and length(\"tool_name\") <= 128)"
      }
    },
