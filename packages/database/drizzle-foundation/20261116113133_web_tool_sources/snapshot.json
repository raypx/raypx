    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "conversation_tool_calls",
        "name": "conversation_tool_calls_web_sources_check",
        "value": "\"web_sources\" is null or (\n        \"finished_at\" is not null and \"outcome\" is not distinct from 'succeeded'\n        and \"tool_name\" in ('web_search', 'web_read')\n        and case when jsonb_typeof(\"web_sources\") = 'array'\n          then jsonb_array_length(\"web_sources\") between 1 and 5\n            and octet_length(\"web_sources\"::text) <= 16384\n          else false end\n      )",
        "entityType": "checks"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"approval_requests\",\"approval_requests_tool_check\"]",
      "set": {
        "value": "(\"tool_name\" in ('computer_list_files', 'computer_read_file', 'computer_write_file', 'computer_run_command', 'computer_screenshot', 'computer_pointer', 'computer_keyboard', 'agent_memory_save', 'agent_memory_update', 'agent_page_create', 'agent_page_update', 'agent_page_read', 'agent_skill_load', 'agent_skill_save', 'web_search', 'web_read') or (\"tool_name\" ~ '^mcp_[a-zA-Z0-9_-]+__[a-zA-Z0-9_-]+$' or \"tool_name\" ~ '^openapi_[a-f0-9]{32}__[a-zA-Z0-9_-]{1,64}$') and length(\"tool_name\") <= 128)"
      }
    },
