{
  "name": "@raypx/task-graph",
  "version": "0.0.0",
  "private": true,
  "description": "VP task registration: workspace discovery, the Raypx task graph, cache inputs and task leaves.",
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./model": "./src/model.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./browser-tests": "./src/browser-tests.ts",
    "./workspaces": "./src/workspaces.ts",
    "./core": "./src/core.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vp test --run tests/integration"
  },
  "devDependencies": {
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "target": "node"
  }
}
