{
  "name": "@raypx/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types-entry.ts",
    "./testing": "./src/testing.ts",
    "./messages": "./src/messages/index.ts",
    "./preferences": "./src/preferences.ts",
    "./browser": "./src/browser.tsx"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component/**' --exclude '**/integration/**'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration/",
    "test:component": "bun --bun vp test --run --passWithNoTests component/",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@voidmix/intl": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@voidmix/tsconfig": "catalog:dev",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./client": "browser",
      "./browser": "browser",
      "./testing": "universal"
    },
    "sourceTargets": {
      "src/client.ts": "browser",
      "src/browser.tsx": "browser",
      "src/testing.ts": "universal",
      "src/browser/**": "browser"
    }
  }
}
