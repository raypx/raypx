{
  "name": "@raypx/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#catalogs": "./src/catalogs/static.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types-entry.ts",
    "./messages": "./src/messages/index.ts",
    "./preferences": "./src/preferences.ts",
    "./browser": "./src/browser.tsx",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --project server",
    "test:component": "bun --bun vp test --run --project browser",
    "test:coverage": "bun --bun vp test --run --coverage"
  },
  "dependencies": {
    "@raypx-kit/intl": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./browser": "browser",
      "./vite": "node"
    },
    "sourceTargets": {
      "src/browser.tsx": "browser",
      "src/catalogs/lazy.ts": "browser",
      "src/vite.ts": "node",
      "src/testing.ts": "universal"
    },
    "entryConsumers": {
      "./config": "Tooling reads the static language policy by package path (locales/policy defaults); it is data, not an import."
    }
  }
}
