{
  "name": "@raypx/scripts",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "rpx": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "doctor": "rpx doctor",
    "deps:dedupe": "rpx deps dedupe",
    "deps:dedupe:check": "rpx deps dedupe --check",
    "deps:audit": "rpx deps audit",
    "deps:check": "rpx deps check",
    "deps:update": "rpx deps update",
    "skills:update": "rpx skills update",
    "policy": "rpx policy",
    "i18n:check": "rpx i18n",
    "clean": "rpx clean",
    "clean:all": "rpx clean --dependencies",
    "clean:bun-cache": "rpx clean --bun-cache",
    "db:migrate": "rpx db migrate",
    "db:push": "rpx db push",
    "db:clean": "rpx db clean",
    "db:studio": "rpx db studio",
    "db:explain": "rpx db explain",
    "generate": "rpx generate",
    "desktop:build": "rpx desktop build",
    "verify": "rpx verify",
    "shadcn:update": "rpx shadcn update",
    "check": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:tooling",
    "@raypx/db": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/shared": "workspace:*",
    "citty": "catalog:tooling",
    "oxc-parser": "catalog:tooling"
  },
  "devDependencies": {
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:tooling"
  }
}
