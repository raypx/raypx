{
  "name": "@raypx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema.ts",
    "./diagnostics": "./src/diagnostics.ts"
  },
  "scripts": {
    "check": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "generate": "rpx env -- drizzle-kit generate --config drizzle.config.ts",
    "test:postgres": "bun --bun vp test --run --config vitest.postgres.config.ts"
  },
  "dependencies": {
    "@raypx/core": "workspace:*",
    "@raypx/shared": "workspace:*",
    "@voidmix/drizzle": "catalog:backend",
    "@voidmix/env": "catalog:",
    "drizzle-orm": "catalog:backend",
    "postgres": "catalog:backend"
  },
  "devDependencies": {
    "@raypx/application": "workspace:*",
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "catalog:tooling",
    "drizzle-kit": "catalog:backend"
  }
}
