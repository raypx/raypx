{
  "name": "@raypx/blocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./command-palette": "./src/components/command-palette.tsx",
    "./preference-controls": "./src/components/preference-controls.tsx",
    "./settings": "./src/components/settings.tsx",
    "./shell": "./src/components/shell.tsx",
    "./styles.css": "./src/styles.css",
    "./messages/en": "./locales/en/index.ts",
    "./messages/zh": "./locales/zh/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:component": "bun --bun vp test --run .component.test."
  },
  "dependencies": {
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/ui": "workspace:*"
  },
  "devDependencies": {
    "@raypx/task-graph": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:dev"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "browser",
    "entryTargets": {
      "./messages/en": "universal",
      "./messages/zh": "universal"
    },
    "sourceTargets": {
      "locales/**": "universal"
    }
  }
}
