{
  "name": "@raypx/analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./client": "./src/client/provider.tsx",
    "./client/application": "./src/client/application.tsx",
    "./client/settings": "./src/client/settings.tsx",
    "./client/styles.css": "./src/client/styles.css",
    "./messages/en": "./locales/en/index.ts",
    "./messages/zh": "./locales/zh/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:component": "bun --bun vp test --run .component.test."
  },
  "dependencies": {
    "@raypx-kit/analytics": "catalog:",
    "@raypx/client": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
