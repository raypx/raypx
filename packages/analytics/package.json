{
  "name": "@raypx/analytics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./client": "./src/client/provider.tsx",
    "./client/application": "./src/client/application.tsx",
    "./client/settings": "./src/client/settings.tsx",
    "./client/styles.css": "./src/client/styles.css"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests/unit",
    "test:component": "bun --bun vp test --run tests/component"
  },
  "dependencies": {
    "@raypx-kit/analytics": "catalog:",
    "@raypx/client": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./browser": "browser",
      "./client": "browser",
      "./client/application": "browser",
      "./client/settings": "browser",
      "./client/styles.css": "browser"
    },
    "sourceTargets": {
      "src/browser.ts": "browser",
      "src/client/**": "browser"
    }
  }
}
