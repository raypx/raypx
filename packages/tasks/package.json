{
  "name": "@raypx/tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./client": "./src/client.ts",
    "./client/pending-count": "./src/client/pending-count.tsx",
    "./client/styles.css": "./src/client/styles.css",
    "./client/task-composer": "./src/client/task-composer.tsx"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run --passWithNoTests",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component/**' --exclude '**/integration/**'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration/",
    "test:component": "bun --bun vp test --run --passWithNoTests component/"
  },
  "dependencies": {
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "diff": "catalog:",
    "lucide-react": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./client": "browser",
      "./client/pending-count": "browser",
      "./client/styles.css": "browser",
      "./client/task-composer": "browser"
    },
    "sourceTargets": {
      "src/client.ts": "browser",
      "src/client/**": "browser"
    }
  }
}
