{
  "name": "@raypx/tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./model": "./src/model.ts",
    "./client": "./src/client.ts",
    "./client/pending-count": "./src/client/pending-count.tsx",
    "./client/status": "./src/client/task-status.tsx",
    "./client/styles.css": "./src/client/styles.css",
    "./client/task-composer": "./src/client/task-composer.tsx",
    "./server": "./src/server.ts",
    "./messages/en": "./locales/en/index.ts",
    "./messages/zh": "./locales/zh/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --project unit",
    "test:component": "bun --bun vp test --run --project component",
    "perf:tasks": "bun --bun vp test --run --project unit src/model/conversation-performance.test.ts --reporter=verbose --silent=false"
  },
  "dependencies": {
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "diff": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.105.3",
    "react": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./client": "browser",
      "./client/pending-count": "browser",
      "./client/status": "browser",
      "./client/styles.css": "browser",
      "./client/task-composer": "browser",
      "./server": "node"
    },
    "sourceTargets": {
      "src/client.ts": "browser",
      "src/client/**": "browser",
      "src/server.ts": "node",
      "src/server/**": "node"
    }
  }
}
