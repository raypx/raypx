{
  "name": "@raypx/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./model": "./src/model.ts",
    "./client/styles.css": "./src/client/styles.css",
    "./messages/en": "./locales/en/index.ts",
    "./messages/zh": "./locales/zh/index.ts",
    "./routines": "./src/routines.ts",
    "./routines/postgres": "./src/routines/postgres.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:component": "bun --bun vitest run .component.test.",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:postgres": "bun --bun vitest run --mode postgres"
  },
  "dependencies": {
    "@raypx/core": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/spaces": "workspace:*",
    "@raypx/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
