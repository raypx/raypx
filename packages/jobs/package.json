{
  "name": "@raypx/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./client/styles.css": "./src/client/styles.css"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests --exclude \"**/component/**\"",
    "test:component": "bun --bun vp test --run tests/component"
  },
  "dependencies": {
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/ui": "workspace:*",
    "croner": "catalog:",
    "lucide-react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./client": "browser",
      "./client/styles.css": "browser"
    },
    "sourceTargets": {
      "src/client.ts": "browser",
      "src/client/**": "browser"
    }
  }
}
