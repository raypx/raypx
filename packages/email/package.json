{
  "name": "@raypx/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts"
  },
  "scripts": {
    "email:dev": "bun --bun vp dev --config vite.app.config.ts",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "resend": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/email-preview": "catalog:dev",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
