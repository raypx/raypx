{
  "name": "@raypx/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./safe": "./src/safe.ts",
    "./stream": "./src/stream.ts",
    "./managed": "./src/managed.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vp test --run --coverage"
  },
  "dependencies": {
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@raypx/task-graph": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "node",
    "entryTargets": {
      "./safe": "universal",
      "./managed": "universal"
    },
    "sourceTargets": {
      "src/safe.ts": "universal",
      "src/managed.ts": "universal"
    }
  }
}
