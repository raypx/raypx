{
  "name": "@raypx/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./pipeline": "./src/pipeline.ts",
    "./safe": "./src/safe.ts",
    "./stream": "./src/stream.ts",
    "./managed": "./src/managed.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests/unit",
    "test:coverage": "bun --bun vp test --run --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "evlog": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev"
  },
  "raypx": {
    "kind": "library",
    "target": "node",
    "entryTargets": {
      "./safe": "universal",
      "./managed": "universal"
    },
    "sourceTargets": {
      "src/safe.ts": "universal",
      "src/managed.ts": "universal"
    }
  }
}
