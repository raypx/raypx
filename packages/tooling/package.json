{
  "name": "@raypx/tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build/nitro": "./src/build/nitro.ts",
    "./build/deployment": "./src/build/deployment.ts",
    "./build/analytics": "./src/build/analytics.ts",
    "./build/start-env": "./src/build/start-env.ts",
    "./browser-server": "./src/browser-server.ts",
    "./build/cli": "./src/build/cli.ts",
    "./performance": "./src/performance/run.ts",
    "./build/release": "./src/build/release.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vp test --run tests/integration"
  },
  "devDependencies": {
    "@raypx/task-graph": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "nitro": "catalog:"
  }
}
