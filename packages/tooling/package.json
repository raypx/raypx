{
  "name": "@raypx/tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build/nitro": "./src/build/nitro.ts",
    "./build/deployment": "./src/build/deployment.ts",
    "./build/analytics": "./src/build/analytics.ts",
    "./build/start-env": "./src/build/start-env.ts",
    "./browser-server": "./src/browser-server.ts",
    "./tasks": "./src/tasks/config.ts",
    "./build/cli": "./src/build/cli.ts",
    "./performance": "./src/performance/run.ts",
    "./tasks/model": "./src/tasks/model.ts",
    "./tasks/lifecycle": "./src/tasks/task-lifecycle.ts",
    "./build/release": "./src/build/release.ts",
    "./browser-tests": "./src/browser-tests.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vp test --run tests/integration"
  },
  "dependencies": {
    "@raypx/devkit": "workspace:*",
    "@raypx/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "nitro": "catalog:"
  },
  "raypx": {
    "kind": "tooling",
    "target": "bun",
    "entryTargets": {
      "./build/nitro": "node",
      "./build/deployment": "node",
      "./build/analytics": "node",
      "./build/start-env": "node",
      "./tasks": "node",
      "./build/cli": "node",
      "./tasks/model": "node",
      "./tasks/lifecycle": "node",
      "./build/release": "node",
      "./browser-tests": "node"
    },
    "sourceTargets": {
      "src/build/**": "node",
      "src/tasks/config.ts": "node",
      "src/tasks/model.ts": "node",
      "src/tasks/arguments.ts": "node",
      "src/tasks/delegation.ts": "node",
      "src/browser-tests.ts": "node",
      "src/tasks/task-lifecycle.ts": "node"
    }
  }
}
