{
  "name": "@raypx/tooling",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "raypx-dev": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    "./repository": "./src/repository.ts",
    "./build/nitro": "./src/build/nitro.ts",
    "./build/analytics": "./src/build/analytics.ts",
    "./browser-tests": "./src/browser-tests.ts",
    "./browser-server": "./src/browser-server.ts",
    "./tasks": "./src/tasks/config.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests/unit",
    "test:integration": "bun --bun vp test --run tests/integration",
    "test:inventory": "bun src/cli.ts test inventory",
    "test:backends": "bun src/cli.ts test backends"
  },
  "dependencies": {
    "@posthog/cli": "catalog:dev",
    "@raypx-kit/devkit": "catalog:dev",
    "@raypx-kit/intl": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "nitro": "catalog:"
  },
  "raypx": {
    "kind": "tooling",
    "target": "bun",
    "uncachedTasks": [
      "test"
    ],
    "entryTargets": {
      "./build/nitro": "node",
      "./build/analytics": "node",
      "./tasks": "node"
    },
    "sourceTargets": {
      "src/build/**": "node",
      "src/tasks/config.ts": "node",
      "src/tasks/model.ts": "node",
      "src/tasks/arguments.ts": "node",
      "src/tasks/delegation.ts": "node"
    }
  }
}
