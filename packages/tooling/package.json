{
  "name": "@raypx/tooling",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "raypx-dev": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test"
  },
  "dependencies": {
    "@raypx/i18n": "workspace:*",
    "@voidmix/devkit": "catalog:dev",
    "@voidmix/intl": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:dev",
    "@voidmix/tsconfig": "catalog:dev"
  },
  "raypx": {
    "kind": "tooling",
    "target": "bun"
  }
}
