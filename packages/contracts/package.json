{
  "name": "@raypx/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api": "./src/api.ts",
    "./local": "./src/local.ts",
    "./tasks": "./src/tasks.ts",
    "./terminal": "./src/terminal.ts",
    "./local-client": "./src/local-client.ts",
    "./desktop": "./src/desktop.ts"
  },
  "scripts": {
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:coverage": "bun --bun vitest run --coverage"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@raypx/core": "workspace:*",
    "@raypx/instances": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
