{
  "name": "@raypx/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./page-header": "./src/page-header.tsx",
    "./section-heading": "./src/section-heading.tsx",
    "./empty-state": "./src/empty-state.tsx",
    "./status-badge": "./src/status-badge.tsx",
    "./select-field": "./src/select-field.tsx",
    "./confirmation": "./src/confirmation.tsx",
    ".": "./src/index.ts",
    "./avatar": "./src/avatar.tsx",
    "./logo": "./src/logo.tsx",
    "./toast": "./src/toast/index.tsx",
    "./themes": "./src/themes/index.ts",
    "./themes/config": "./src/themes/config.ts",
    "./components/ui/toast": "./src/components/ui/toast.tsx",
    "./styles.css": "./src/styles.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./modal": "./src/modal.tsx",
    "./loading-state": "./src/loading-state.tsx",
    "./components/ui/tabs": "./src/components/ui/tabs.tsx",
    "./components/ui/skeleton": "./src/components/ui/skeleton.tsx",
    "./components/ui/empty": "./src/components/ui/empty.tsx",
    "./components/ui/alert": "./src/components/ui/alert.tsx",
    "./components/ui/dialog": "./src/components/ui/dialog.tsx",
    "./components/ui/sheet": "./src/components/ui/sheet.tsx",
    "./components/ui/tooltip": "./src/components/ui/tooltip.tsx",
    "./components/ui/popover": "./src/components/ui/popover.tsx",
    "./icon-button": "./src/icon-button.tsx",
    "./help-hint": "./src/help-hint.tsx",
    "./styles/app.css": "./src/styles/app.css"
  },
  "scripts": {
    "check": "bun run scripts/generate-theme.ts --check && bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run --passWithNoTests",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component/**' --exclude '**/integration/**'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration/",
    "test:component": "bun --bun vp test --run --passWithNoTests component/",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "generate:theme": "bun run scripts/generate-theme.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:dev"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "raypx": {
    "kind": "library",
    "target": "browser",
    "entryTargets": {
      "./themes/config": "universal"
    },
    "sourceTargets": {
      "src/themes/config.ts": "universal",
      "src/themes/tokens.ts": "universal",
      "src/themes/script.ts": "universal",
      "scripts/**": "node"
    }
  }
}
