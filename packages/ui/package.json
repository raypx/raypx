{
  "name": "@voidmix/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./textarea": "./src/textarea.tsx",
    "./page-header": "./src/page-header.tsx",
    "./section-heading": "./src/section-heading.tsx",
    "./empty-state": "./src/empty-state.tsx",
    "./status-badge": "./src/status-badge.tsx",
    ".": "./src/index.ts",
    "./avatar": "./src/avatar.tsx",
    "./logo": "./src/logo.tsx",
    "./toast": "./src/toast/index.tsx",
    "./theme": "./src/theme/index.ts",
    "./components/ui/toast": "./src/components/ui/toast.tsx",
    "./styles.css": "./src/styles.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./modal": "./src/modal.tsx",
    "./loading-state": "./src/loading-state.tsx",
    "./components/ui/tabs": "./src/components/ui/tabs.tsx",
    "./components/ui/skeleton": "./src/components/ui/skeleton.tsx",
    "./components/ui/empty": "./src/components/ui/empty.tsx",
    "./components/ui/alert": "./src/components/ui/alert.tsx",
    "./components/ui/separator": "./src/components/ui/separator.tsx",
    "./components/ui/dialog": "./src/components/ui/dialog.tsx",
    "./components/ui/sheet": "./src/components/ui/sheet.tsx",
    "./components/ui/checkbox": "./src/components/ui/checkbox.tsx",
    "./components/ui/table": "./src/components/ui/table.tsx",
    "./components/ui/toggle": "./src/components/ui/toggle.tsx",
    "./components/ui/toggle-group": "./src/components/ui/toggle-group.tsx",
    "./components/ui/tooltip": "./src/components/ui/tooltip.tsx",
    "./components/ui/popover": "./src/components/ui/popover.tsx",
    "./icon-button": "./src/icon-button.tsx",
    "./help-hint": "./src/help-hint.tsx"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run --passWithNoTests",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@base-ui/react": "catalog:frontend",
    "@phosphor-icons/react": "catalog:frontend",
    "class-variance-authority": "catalog:frontend",
    "cn": "catalog:frontend"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:tooling",
    "@testing-library/react": "catalog:tooling",
    "@testing-library/user-event": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*",
    "jsdom": "catalog:tooling",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:tooling"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
