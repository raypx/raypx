{
  "name": "@raypx/account",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./client/styles.css": "./src/client/styles.css",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run --passWithNoTests",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test"
  },
  "dependencies": {
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@voidmix/tsconfig": "catalog:dev",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "raypx": {
    "kind": "library",
    "target": "universal",
    "entryTargets": {
      "./client": "browser",
      "./client/styles.css": "browser",
      "./server": "node"
    },
    "sourceTargets": {
      "src/client.ts": "browser",
      "src/client/**": "browser",
      "src/server.ts": "node"
    }
  }
}
