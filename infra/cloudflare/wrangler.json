{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raypx-relay",
  "main": "dist/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [
    {
      "class_name": "RelayContainer",
      "image": "../relay/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayContainer" }]
  },
  "exports": { "RelayContainer": { "type": "durable-object", "storage": "sqlite" } }
}
