{
  "name": "relay-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/wrangler.ts dev",
    "plan": "tsx scripts/wrangler.ts plan",
    "plan:worker": "tsx scripts/wrangler.ts plan:worker",
    "deploy": "tsx scripts/wrangler.ts deploy",
    "build": "vp build --config vite.app.config.ts",
    "check": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project src/tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\""
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@raypx/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "node",
    "sourceTargets": {
      "scripts/**": "node"
    },
    "uncachedTasks": [
      "dev",
      "plan",
      "plan:worker",
      "deploy"
    ]
  }
}
