{
  "name": "relay-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/wrangler.ts dev",
    "plan": "bun scripts/wrangler.ts plan",
    "plan:worker": "bun scripts/wrangler.ts plan:worker",
    "deploy": "bun scripts/wrangler.ts deploy",
    "build": "bun --bun vp build --config vite.app.config.ts",
    "check": "bun --check --tsconfig-override tsconfig.json && bun --check --tsconfig-override src/tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests/unit"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:dev",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "node",
    "sourceTargets": {
      "scripts/**": "bun"
    },
    "uncachedTasks": [
      "dev",
      "plan",
      "plan:worker",
      "deploy"
    ]
  }
}
