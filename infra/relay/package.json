{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "raypx-dev env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "vp build --config vite.app.config.ts",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:integration": "vp test --run tests/integration"
  },
  "dependencies": {
    "@raypx/contracts": "workspace:*",
    "@raypx/control": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/env": "workspace:*",
    "@raypx/memory-server": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "node"
  }
}
