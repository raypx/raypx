{
  "name": "@raypx/infra-railway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./railway.ts"
  },
  "scripts": {
    "plan": "railway config plan --file railway.ts",
    "deploy": "railway config apply --file railway.ts",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\""
  },
  "dependencies": {
    "@raypx/tooling": "workspace:*",
    "railway": "catalog:dev"
  },
  "devDependencies": {
    "@railway/cli": "catalog:dev",
    "@raypx/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "tooling",
    "target": "node",
    "uncachedTasks": [
      "plan",
      "deploy"
    ],
    "entryConsumers": {
      ".": "The Railway CLI evaluates railway.ts with Node as an IaC program; no workspace imports it."
    }
  }
}
