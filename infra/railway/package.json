{
  "name": "@raypx/infra-railway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./railway.ts"
  },
  "scripts": {
    "plan": "BUN_OPTIONS=--preload=./scripts/iac-preload.ts bunx --bun @railway/cli config plan --file railway.ts",
    "deploy": "BUN_OPTIONS=--preload=./scripts/iac-preload.ts bunx --bun @railway/cli config apply --file railway.ts",
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\""
  },
  "dependencies": {
    "@raypx/tooling": "workspace:*",
    "railway": "catalog:dev"
  },
  "devDependencies": {
    "@railway/cli": "catalog:dev",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "tooling",
    "target": "bun",
    "uncachedTasks": [
      "plan",
      "deploy"
    ],
    "entryConsumers": {
      ".": "The Railway CLI loads railway.ts through scripts/iac-preload.ts as an IaC program; no workspace imports it."
    }
  }
}
