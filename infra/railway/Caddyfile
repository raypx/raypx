{
	admin off
	auto_https off
	persist_config off
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:{$PORT:8080} {
	@api path /api/* /rpc/* /relay /health /ready
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
}
