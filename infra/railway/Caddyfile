{
	admin off
	auto_https off
	persist_config off
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:{$PORT:8080} {
  @relay path /relay
  handle @relay {
    reverse_proxy {$API_UPSTREAM} {
      header_up -Cookie
      header_up -Authorization
    }
  }
  @api path /api/* /rpc/* /routines/* /device/* /.well-known/openid-configuration /.well-known/oauth-authorization-server /events /health /ready
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
}
