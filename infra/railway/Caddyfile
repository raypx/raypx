{
	admin off
	auto_https off
	persist_config off
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

:{$PORT:8080} {
  header X-Raypx-Gateway-Revision "__RAYPX_BUILD_REVISION__"
  @relay path /api/device/connect
  handle @relay {
    reverse_proxy {$API_UPSTREAM} {
      header_up -Cookie
    }
  }
  @api path /api/* /.well-known/openid-configuration /.well-known/oauth-authorization-server /health /ready
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}
}
