SANDBOX_LISTEN_ADDRESS=127.0.0.1
SANDBOX_PORT=4020
SANDBOX_SUPERVISOR_TOKEN=
# Only this service reads a socket setting. Never forward it to API or a computer.
SANDBOX_ENGINE_SOCKET=/var/run/docker.sock
SANDBOX_STATE_DIRECTORY=/var/lib/raypx-sandbox
SANDBOX_COMPUTER_IMAGE=
# Requires the explicitly built --target graphical image. Default stays headless.
SANDBOX_GRAPHICAL=false
SANDBOX_NAMESPACE=raypx
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_RESTRICTED_EGRESS=false
SANDBOX_HOST_RULES_APPLIED=false
# Use the same public IPv4 resolver with egress.sh --resolver.
SANDBOX_DNS_RESOLVER=1.1.1.1
