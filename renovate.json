{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "github-actions", "custom.regex"],
  "timezone": "Asia/Singapore",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 4,
  "automerge": false,
  "rangeStrategy": "replace",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Vite+ owns the Vite alias and bundled Vitest version; validate the whole toolchain together.",
      "matchPackageNames": [
        "vite",
        "vite-plus",
        "@voidzero-dev/vite-plus-*",
        "vitest",
        "@vitest/*"
      ],
      "groupName": "Vite+ and Vitest",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["storybook", "@storybook/*"],
      "groupName": "Storybook",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["playwright", "playwright-core", "@playwright/*"],
      "groupName": "Playwright",
      "separateMajorMinor": false
    },
    {
      "description": "Runtime pins also require version files, devEngines, and compatibility validation; update them manually together.",
      "matchPackageNames": ["bun", "node"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "description": "Root Bun catalog pins; the Bun manager does not extract workspaces.catalog.",
      "matchStrings": [
        "\"catalog\"\\s*:\\s*\\{[^}]*\\}",
        "\"(?<depName>[^\"\\s]+)\"\\s*:\\s*\"(?<currentValue>[~^]?[0-9][^\"]*)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "description": "Extract npm aliases in the Bun catalog and wildcard overrides, which native Bun extraction skips.",
      "matchStrings": [
        "\"(?:catalog|overrides)\"\\s*:\\s*\\{[^}]*\\}",
        "\"[^\"]+\"\\s*:\\s*\"npm:(?<depName>@?[^\"@]+)@(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
