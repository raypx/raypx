  },
  "type": "module",
  "scripts": {
    "doctor": "vmx doctor",
    "policy": "vmx policy",
    "policy:fix": "vmx policy --fix",
    "i18n:check": "vmx i18n",
    "skills:update": "vmx skills update",
    "clean": "vmx clean",
    "clean:all": "vmx clean --dependencies",
    "clean:bun-cache": "vmx clean --bun-cache",
    "deps:check": "vmx deps check",
    "deps:update": "vmx deps update",
    "deps:dedupe": "vmx deps dedupe",
    "deps:dedupe:check": "vmx deps dedupe --check",
    "deps:audit": "vmx deps audit",
    "dev": "vmx tasks dev --filter './apps/*' --filter @voidmix/shared --concurrency=10",
    "build": "vmx tasks build",
    "check": "vmx tasks check",
    "lint": "vmx tasks lint:leaf",
    "knip:report": "knip --no-progress --reporter compact --no-exit-code",
    "format": "vmx tasks format:leaf",
    "format:fix": "vp fmt",
    "test": "vmx tasks test --filter !@voidmix/e2e",
    "test:unit": "vmx tasks test:unit --filter !@voidmix/e2e",
    "test:integration": "vmx tasks test:integration --filter !@voidmix/e2e",
    "test:component": "vmx tasks test:component --filter !@voidmix/e2e",
    "test:coverage": "vmx tasks test:coverage --filter !@voidmix/e2e",
    "test:e2e": "vmx tasks e2e --filter @voidmix/e2e",
    "db:migrate": "vmx db migrate",
    "db:push": "vmx db push",
    "db:clean": "vmx db clean",
    "db:seed": "vmx db seed",
    "db:studio": "vmx db studio",
    "admin:create": "vmx admin create",
    "generate": "vmx generate",
    "desktop:build": "vmx desktop build",
    "desktop:prepare": "vmx desktop prepare",
    "storybook": "bun run --cwd apps/storybook dev",
    "storybook:build": "vmx tasks build --filter @voidmix/storybook",
    "verify": "vmx verify",
    "shadcn:update": "vmx shadcn update",
    "postinstall": "bun run --cwd packages/shared build",
    "test:postgres": "vmx tasks test:postgres --filter @voidmix/db",
    "build:web": "vmx tasks build --filter @voidmix/web",
    "build:api": "vmx tasks build --filter @voidmix/api",
    "build:worker": "vmx tasks build --filter @voidmix/worker",
    "build:desktop": "vmx tasks build --filter @voidmix/desktop",
    "lint:leaf": "vp lint",
    "format:leaf": "vp fmt --check",
    "build:desktop:native-prep": "bun run desktop:prepare && bun run build:desktop"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:tooling",
    "@voidmix/scripts": "workspace:*",
    "knip": "catalog:tooling",
    "tailwindcss": "catalog:frontend",
    "taze": "catalog:tooling",
    "turbo": "catalog:tooling",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "overrides": {
    "esbuild": "catalog:tooling",
    "jiti": "catalog:tooling",
    "lightningcss": "catalog:tooling",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.0"
}
