{
  "name": "raypx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@voidmix/env": "0.0.0-alpha.1",
      "@better-auth/drizzle-adapter": "^1.7.7",
      "@orpc/client": "2.0.0-beta.43",
      "@orpc/contract": "2.0.0-beta.43",
      "@orpc/server": "2.0.0-beta.43",
      "@tanstack/react-router": "^1.170.42",
      "@tanstack/react-start": "1.169.2",
      "better-auth": "^1.7.7",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "zod": "^4.6.7",
      "@better-auth/expo": "1.7.7",
      "croner": "10.0.1",
      "@xterm/xterm": "6.0.0",
      "@xterm/addon-fit": "0.11.0"
    },
    "catalogs": {
      "backend": {
        "drizzle-kit": "1.0.0-rc.5-5935859",
        "drizzle-orm": "1.0.0-rc.5-5935859",
        "hono": "^4.13.13",
        "nitro": "3.0.260903-beta",
        "postgres": "^3.4.9"
      },
      "frontend": {
        "@base-ui/react": "^1.9.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "electrobun": "2.0.2",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "resend": "^6.32.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "@voidmix/intl": "0.0.0-alpha.0"
      },
      "tooling": {
        "@dotenvx/dotenvx": "^2.34.2",
        "@playwright/test": "^1.64.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@vitest/coverage-v8": "5.0.3",
        "@voidmix/tsconfig": "0.0.0-alpha.0",
        "knip": "^6.41.0",
        "jsdom": "^30.1.2",
        "@types/node": "^24.19.2",
        "@types/bun": "1.4.3",
        "@types/react": "19.2.4",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "^6.1.2",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0",
        "vite-plus": "^1.1.0",
        "oxc-parser": "^0.153.0",
        "turbo": "2.11.7",
        "esbuild": "^0.28.2",
        "jiti": "^2.7.0",
        "lightningcss": "^1.33.0"
      },
      "mobile": {
        "expo": "57.0.29",
        "expo-router": "~57.0.27",
        "expo-secure-store": "~57.0.4",
        "expo-linking": "~57.0.13",
        "expo-constants": "~57.0.22",
        "expo-status-bar": "~57.0.1",
        "expo-localization": "~57.0.2",
        "expo-splash-screen": "~57.0.10",
        "react-native": "0.86.3",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "@react-native-async-storage/async-storage": "2.2.0",
        "uniwind": "1.12.2",
        "expo-doctor": "1.20.4",
        "typescript": "~6.0.3"
      }
    }
  },
  "type": "module",
  "scripts": {
    "raypx-dev": "bun packages/tooling/src/cli.ts",
    "doctor": "raypx-dev doctor",
    "workspace:list": "raypx-dev workspace list",
    "workspace:new": "raypx-dev workspace new",
    "policy": "raypx-dev policy",
    "i18n:check": "raypx-dev i18n",
    "dev": "raypx-dev tasks dev --filter web --filter api",
    "dev:desktop": "raypx-dev tasks dev --filter desktop",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "build": "raypx-dev tasks build",
    "build:web": "raypx-dev tasks build --filter web",
    "build:api": "raypx-dev tasks build --filter api",
    "build:desktop": "raypx-dev tasks build --filter desktop",
    "build:cli": "raypx-dev tasks build --filter cli",
    "check": "raypx-dev tasks check",
    "test": "raypx-dev tasks test",
    "test:unit": "raypx-dev tasks test:unit",
    "test:integration": "raypx-dev tasks test:integration",
    "test:component": "raypx-dev tasks test:component",
    "test:coverage": "raypx-dev tasks test:coverage",
    "lint": "bun --bun vp lint",
    "format": "bun --bun vp fmt --check",
    "format:fix": "bun --bun vp fmt --write",
    "verify": "raypx-dev verify",
    "smoke": "raypx-dev smoke",
    "test:e2e": "raypx-dev tasks e2e",
    "test:postgres": "raypx-dev tasks test:postgres --filter api",
    "mobile:check": "bun run --cwd apps/mobile doctor",
    "mobile:bundle": "bun run --cwd apps/mobile bundle",
    "desktop:build": "raypx-dev desktop build",
    "db:migrate": "raypx-dev db migrate",
    "generate": "raypx-dev db generate",
    "clean": "raypx-dev clean",
    "deps:audit": "bun audit"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/bun": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@voidmix/tsconfig": "catalog:tooling",
    "knip": "catalog:tooling",
    "tailwindcss": "catalog:frontend",
    "taze": "catalog:tooling",
    "turbo": "catalog:tooling",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "overrides": {
    "esbuild": "catalog:tooling",
    "jiti": "catalog:tooling",
    "lightningcss": "catalog:tooling",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "bun@1.4.3"
}
