      "better-auth": "^1.7.7",
      "evlog": "^2.31.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "use-intl": "^4.14.9",
      "uuid": "^14.0.3",
      "zod": "^4.6.6"
    },
    "catalogs": {
      "backend": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/s3-presigned-post": "^3.1149.0",
        "@aws-sdk/s3-request-presigner": "^3.1149.0",
        "exceljs": "^4.4.0",
