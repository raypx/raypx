{
  "name": "raypx",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "raypx-dev": "raypx-dev",
    "doctor": "raypx-dev doctor",
    "workspace:list": "raypx-dev workspace list",
    "workspace:new": "raypx-dev workspace new",
    "policy": "raypx-dev policy",
    "i18n:check": "raypx-dev i18n",
    "dev": "raypx-dev tasks dev --filter web --filter api --filter relay --concurrency-limit=3",
    "dev:desktop": "raypx-dev tasks dev --filter desktop",
    "dev:storybook": "raypx-dev tasks dev --filter ui-storybook",
    "build": "raypx-dev tasks build",
    "build:web": "raypx-dev tasks build --filter web",
    "build:api": "raypx-dev tasks build --filter api",
    "build:desktop": "raypx-dev tasks build --filter desktop",
    "build:cli": "raypx-dev tasks build --filter cli",
    "build:storybook": "raypx-dev tasks build --filter ui-storybook",
    "size": "raypx-dev size",
    "check": "raypx-dev tasks check",
    "test": "raypx-dev test",
    "lint": "vp lint",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "verify": "raypx-dev verify",
    "smoke": "raypx-dev smoke",
    "smoke:deployment": "raypx-dev deployment:smoke",
    "package:desktop": "raypx-dev desktop build",
    "db:migrate": "raypx-dev db migrate",
    "db:generate": "raypx-dev db generate",
    "db:studio": "raypx-dev db studio",
    "clean": "raypx-dev clean",
    "clean:artifacts": "raypx-dev clean:artifacts",
    "deps:audit": "pnpm audit",
    "skills:update": "DO_NOT_TRACK=1 skills update --project --yes",
    "analytics:sourcemaps": "raypx-dev analytics sourcemaps",
    "knip": "raypx-dev knip",
    "perf:tasks": "raypx-dev tasks perf:tasks",
    "eval:agents": "raypx-dev tasks cli#eval:agents --",
    "build:relay": "raypx-dev tasks build --filter relay",
    "dev:mobile": "raypx-dev tasks dev --filter mobile"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "knip": "catalog:dev",
    "skills": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@12.16.1"
}
