{
  "name": "voidmix",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@orpc/client": "2.0.0-beta.41",
      "@orpc/contract": "2.0.0-beta.41",
      "@orpc/server": "2.0.0-beta.41",
      "@earendil-works/pi-coding-agent": "^1.0.2",
      "@better-auth/drizzle-adapter": "^1.7.7",
      "better-auth": "^1.7.7",
      "evlog": "^2.30.0",
      "use-intl": "^4.14.9",
      "@tanstack/react-router": "^1.170.41",
      "@tanstack/react-start": "^1.168.60",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "zod": "^4.6.5",
      "uuid": "^14.0.2",
      "@earendil-works/pi-ai": "1.0.2"
    },
    "catalogs": {
      "backend": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/s3-presigned-post": "^3.1146.0",
        "@aws-sdk/s3-request-presigner": "^3.1146.0",
        "exceljs": "^4.4.0",
        "pdfkit": "^0.20.2",
        "pptxgenjs": "^4.0.1",
        "@sentry/node": "^11.4.0",
        "drizzle-kit": "1.0.0-rc.5-5935859",
        "drizzle-orm": "1.0.0-rc.5-5935859",
        "hono": "^4.13.13",
        "ioredis": "^6.0.0",
        "nanoid": "^6.0.1",
        "nitro": "3.0.260903-beta",
        "postgres": "^3.4.9"
      },
      "frontend": {
        "@sentry/react": "^11.4.0",
        "posthog-js": "^1.435.9",
        "streamdown": "2.7.0",
        "@pierre/diffs": "1.5.1",
        "@base-ui/react": "^1.8.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/api": "^2.12.1",
        "@tauri-apps/cli": "^2.12.1",
        "class-variance-authority": "^0.7.1",
