{
  "name": "raypx",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@better-auth/drizzle-adapter": "^1.7.10",
      "@better-auth/expo": "1.7.10",
      "@orpc/client": "2.0.0-beta.43",
      "@orpc/contract": "2.0.0-beta.43",
      "@orpc/server": "2.0.0-beta.43",
      "@react-native-async-storage/async-storage": "2.2.0",
      "@tanstack/react-router": "^1.170.45",
      "@tanstack/react-start": "1.169.3",
      "@voidmix/env": "0.0.0-alpha.3",
      "@voidmix/intl": "0.0.0-alpha.3",
      "@xterm/addon-fit": "0.11.0",
      "@xterm/xterm": "6.0.0",
      "better-auth": "^1.7.10",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.0",
      "croner": "10.0.1",
      "drizzle-orm": "1.0.0-rc.5-5935859",
      "electrobun": "2.0.2",
      "expo": "58.0.14",
      "expo-constants": "~58.0.12",
      "expo-linking": "~58.0.13",
      "expo-localization": "~58.0.4",
      "expo-router": "~58.0.23",
      "expo-secure-store": "~58.0.2",
      "expo-splash-screen": "~58.0.10",
      "expo-status-bar": "~58.0.3",
      "hono": "^4.13.13",
      "lucide-react": "^1.59.0",
      "nitro": "3.0.260903-beta",
      "postgres": "^3.4.9",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-native": "0.88.0",
      "react-native-safe-area-context": "~5.10.1",
      "react-native-screens": "~4.30.0",
      "resend": "^6.34.1",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "uniwind": "1.12.2",
      "zod": "^4.6.7",
      "zustand": "^5.0.15"
    },
    "catalogs": {
      "dev": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bun": "1.4.3",
        "@types/node": "^24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "5.0.5",
        "@voidmix/devkit": "0.0.0-alpha.0",
        "@voidmix/tsconfig": "0.0.0-alpha.0",
        "drizzle-kit": "npm:@voidmix/drizzle-kit@0.0.0-alpha.0",
        "esbuild": "^0.28.2",
        "expo-doctor": "1.21.5",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "knip": "^6.41.0",
        "lightningcss": "^1.33.0",
        "turbo": "2.11.9",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
        "vite-plus": "^1.3.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "raypx-dev": "bun packages/tooling/src/cli.ts",
    "doctor": "raypx-dev doctor",
    "workspace:list": "raypx-dev workspace list",
    "workspace:new": "raypx-dev workspace new",
    "policy": "raypx-dev policy",
    "i18n:check": "raypx-dev i18n",
    "dev": "raypx-dev tasks dev --filter web --filter api",
    "dev:desktop": "raypx-dev tasks dev --filter desktop",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "build": "raypx-dev tasks build",
    "build:web": "raypx-dev tasks build --filter web",
    "build:api": "raypx-dev tasks build --filter api",
    "build:desktop": "raypx-dev tasks build --filter desktop",
    "build:cli": "raypx-dev tasks build --filter cli",
    "check": "raypx-dev tasks check",
    "test": "raypx-dev tasks test",
    "test:unit": "raypx-dev tasks test:unit",
    "test:integration": "raypx-dev tasks test:integration",
    "test:component": "raypx-dev tasks test:component",
    "test:coverage": "raypx-dev tasks test:coverage",
    "lint": "bun --bun vp lint",
    "format": "bun --bun vp fmt --check",
    "format:fix": "bun --bun vp fmt --write",
    "verify": "raypx-dev verify",
    "smoke": "raypx-dev smoke",
    "test:e2e": "raypx-dev tasks e2e",
    "test:postgres": "raypx-dev tasks test:postgres --filter api",
    "mobile:check": "bun run --cwd apps/mobile doctor",
    "mobile:bundle": "bun run --cwd apps/mobile bundle",
    "desktop:build": "raypx-dev desktop build",
    "db:migrate": "raypx-dev db migrate",
    "generate": "raypx-dev db generate",
    "clean": "raypx-dev clean",
    "deps:audit": "bun audit"
  },
  "devDependencies": {
    "@raypx/tooling": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@voidmix/tsconfig": "catalog:dev",
    "knip": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "overrides": {
    "@types/node": "catalog:dev",
    "esbuild": "catalog:dev",
    "jiti": "catalog:dev",
    "lightningcss": "catalog:dev",
    "vite": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "bun@1.4.3"
}
