    "aria-query": "^5.3.2",
    "lightningcss": "catalog:dev",
    "oxc-parser": "0.157.0",
    "oxlint": "1.90.0",
    "vite": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "error"
    }
  },
  "packageManager": "bun@1.4.4"
