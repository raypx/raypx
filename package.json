{
  "name": "raypx",
  "version": "0.1.0",
  "private": true,
  "author": "Zack <heyloyep@gmail.com>",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "vite-plus": "1.1.0",
      "evlog": "2.30.1",
      "better-sqlite3": "11.8.1",
      "drizzle-orm": "0.36.4",
      "better-auth": "1.6.1",
      "unstorage": "1.14.1",
      "ioredis": "5.4.2",
      "vitest": "5.0.3",
      "@vitest/coverage-v8": "5.0.3",
      "@vitest/browser-playwright": "5.0.3",
      "playwright": "1.64.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@types/node": "^22.19.0",
      "@tanstack/react-query": "5.104.1",
      "jsdom": "29.0.1",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "^14.6.1"
    }
  },
  "type": "module",
  "scripts": {
    "raypx": "bun --no-env-file --no-install scripts/bin/raypx.ts",
    "clean": "bun --no-env-file --no-install scripts/bin/raypx.ts clean",
    "prepare": "vp config --hooks-dir .vite-hooks --no-agent",
    "staged": "vp staged",
    "prestaged": "bun packages/config/src/environment.ts",
    "dev": "vp run --filter \"@raypx/*\" --filter \"!@raypx/web\" build && vp run --filter \"@raypx/*\" --parallel dev",
    "build": "vp run --filter \"@raypx/*\" build",
    "start": "vp run @raypx/web#start",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "typecheck": "vp run --filter \"@raypx/*\" typecheck && bun run typecheck:scripts",
    "test": "vp run --filter \"@raypx/*\" test && bun run test:scripts",
    "check": "bun --no-env-file --no-install scripts/bin/raypx.ts verify",
    "verify": "bun --no-env-file --no-install scripts/bin/raypx.ts verify",
    "policy": "bun --no-env-file --no-install scripts/bin/raypx.ts policy",
    "lint:fix": "vp lint --fix --deny-warnings",
    "format:check": "vp fmt --check",
    "test:watch": "vp test watch --project '!web-integration'",
    "test:coverage": "vp run --filter \"@raypx/*\" build && vp test run --coverage",
    "check:boundaries": "bun packages/config/src/check-boundaries.ts",
    "check:env": "bun --no-env-file --no-install scripts/bin/raypx.ts env",
    "doctor": "bun --no-env-file --no-install scripts/bin/raypx.ts doctor",
    "check:unused": "knip --config knip.ts",
    "check:consumer": "bun --no-env-file --no-install scripts/bin/raypx.ts consumer",
    "test:e2e": "bun run build && bun --no-env-file run --cwd apps/web playwright test --config playwright.config.ts",
    "test:consumer:browser": "bun --no-env-file --no-install scripts/bin/raypx.ts consumer-browser",
    "precheck:unused": "bun packages/config/src/environment.ts",
    "pretest:e2e": "bun packages/config/src/environment.ts",
    "preinstall": "bun packages/config/src/environment.ts",
    "predev": "bun packages/config/src/environment.ts",
    "prebuild": "bun packages/config/src/environment.ts",
    "prestart": "bun packages/config/src/environment.ts",
    "prelint": "bun packages/config/src/environment.ts",
    "preformat": "bun packages/config/src/environment.ts",
    "pretypecheck": "bun packages/config/src/environment.ts",
    "pretest": "bun packages/config/src/environment.ts",
    "prelint:fix": "bun packages/config/src/environment.ts",
    "preformat:check": "bun packages/config/src/environment.ts",
    "pretest:watch": "bun packages/config/src/environment.ts",
    "pretest:coverage": "bun packages/config/src/environment.ts",
    "precheck:boundaries": "bun packages/config/src/environment.ts",
    "setup": "bun --no-env-file --no-install scripts/bin/raypx.ts setup",
    "check:runtime-env": "bun --cwd apps/web run ../../packages/env/src/cli.ts",
    "storybook": "vp run @raypx/ui#storybook",
    "storybook:build": "vp run @raypx/ui#storybook-build",
    "storybook:test": "vp run @raypx/ui#storybook-test",
    "storybook:install": "vp run @raypx/ui#storybook-install",
    "prestorybook": "bun packages/config/src/environment.ts",
    "prestorybook:build": "bun packages/config/src/environment.ts",
    "prestorybook:test": "bun packages/config/src/environment.ts",
    "db:migrate": "bun --cwd apps/web run ../../packages/db/src/cli.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test:scripts": "vp test run --project scripts",
    "pretypecheck:scripts": "bun packages/config/src/environment.ts",
    "pretest:scripts": "bun packages/config/src/environment.ts",
    "deps:check": "bun --no-env-file --no-install scripts/bin/raypx.ts deps",
    "deps:outdated": "bun outdated --recursive",
    "deps:update": "bun update --recursive",
    "test:unit": "vp test run --project '!web-integration'",
    "test:integration": "vp run @raypx/web#test:integration",
    "predeps:outdated": "bun packages/config/src/environment.ts",
    "predeps:update": "bun packages/config/src/environment.ts",
    "pretest:unit": "bun packages/config/src/environment.ts",
    "pretest:integration": "bun packages/config/src/environment.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.87.0",
    "@raypx/config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "catalog:",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "knip": "6.16.0",
    "playwright": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite@*": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.1",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": "1.4.2",
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2"
}
