  "type": "module",
  "scripts": {
    "doctor": "rpx doctor",
    "policy": "rpx policy",
    "policy:fix": "rpx policy --fix",
    "i18n:check": "rpx i18n",
    "skills:update": "rpx skills update",
    "clean": "rpx clean",
    "clean:all": "rpx clean --dependencies",
    "clean:bun-cache": "rpx clean --bun-cache",
    "deps:check": "rpx deps check",
    "deps:update": "rpx deps update",
    "deps:dedupe": "rpx deps dedupe",
    "deps:dedupe:check": "rpx deps dedupe --check",
    "deps:audit": "rpx deps audit",
    "dev": "rpx tasks dev --filter './apps/*' --filter @raypx/shared --concurrency=10",
    "build": "rpx tasks build",
    "check": "rpx tasks check",
    "lint": "rpx tasks lint:leaf",
    "knip:report": "bun --bun knip --no-progress --reporter compact --no-exit-code",
    "format": "rpx tasks format:leaf",
    "format:fix": "bun --bun vp fmt",
    "test": "rpx tasks test --filter !@raypx/e2e",
    "test:unit": "rpx tasks test:unit --filter !@raypx/e2e",
    "test:integration": "rpx tasks test:integration --filter !@raypx/e2e",
    "test:component": "rpx tasks test:component --filter !@raypx/e2e",
    "test:coverage": "rpx tasks test:coverage --filter !@raypx/e2e",
    "test:e2e": "rpx e2e",
    "test:e2e:web": "rpx e2e web",
    "test:e2e:desktop": "rpx e2e desktop",
    "db:migrate": "rpx db migrate",
    "db:push": "rpx db push",
    "db:clean": "rpx db clean",
    "db:studio": "rpx db studio",
    "db:explain": "rpx db explain",
    "generate": "rpx generate",
    "desktop:build": "rpx desktop build",
    "storybook": "bun run --cwd apps/bun --bun storybook dev",
    "storybook:build": "rpx tasks build --filter bun --bun storybook",
    "verify": "rpx verify",
    "shadcn:update": "rpx shadcn update",
    "postinstall": "bun run --cwd packages/shared build",
    "test:postgres": "rpx tasks test:postgres --filter @raypx/db",
    "build:web": "rpx tasks build --filter web",
    "build:api": "rpx tasks build --filter api",
    "build:worker": "rpx tasks build --filter worker",
    "build:desktop": "rpx tasks build --filter desktop",
    "lint:leaf": "bun --bun vp lint",
    "format:leaf": "bun --bun vp fmt --check"
  },
  "devDependencies": {
    "@raypx/scripts": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:tooling",
    "knip": "catalog:tooling",
    "tailwindcss": "catalog:frontend",
    "taze": "catalog:tooling",
    "turbo": "catalog:tooling",
    "tw-animate-css": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "overrides": {
    "esbuild": "catalog:tooling",
    "jiti": "catalog:tooling",
    "lightningcss": "catalog:tooling",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "packageManager": "bun@1.4.0"
}
