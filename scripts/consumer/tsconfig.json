{
  "extends": "@raypx/config/tsconfig/node.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "*.ts",
    "../check-consumer.ts",
    "../test-consumer-browser.ts",
    "../../playwright.consumer.config.ts"
  ]
}
