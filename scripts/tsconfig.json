{
  "extends": "@raypx/config/tsconfig/node.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts", "../knip.ts", "../vite.config.ts", "../playwright.consumer.config.ts"]
}
