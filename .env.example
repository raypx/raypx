# Runtime
NODE_ENV=development
CI=false

# API
VITE_API_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECRET=raypx-development-secret-change-me
AUTH_URL=
AUTH_DOMAIN=

# Database
DATABASE_URL=postgres://raypx:raypx@localhost:5432/raypx
# Compose defaults; use the existing database/volume names when reusing local data.
RAYPX_POSTGRES_DB=raypx
# RAYPX_POSTGRES_VOLUME=your-existing-volume-name

# AI admission limiter; required before enabling production AI
REDIS_URL=
CACHE_PREFIX=raypx
CACHE_REDIS_CONNECT_TIMEOUT_MS=10000
CACHE_REDIS_OPERATION_TIMEOUT_MS=5000
CACHE_REDIS_MAX_RETRIES_PER_REQUEST=1

# Auth mail compatibility fallback (DB settings take precedence; logger fallback in development/test)
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Raypx
MAIL_DEFAULT_LOCALE=en
EMAIL_TEMPLATES_BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
VITE_LOG_LEVEL=debug
VITE_LOG_PRETTY=true

# Cloud execution is unavailable after the provider adapter was removed (ADR-0027).
CLOUD_SEARCH_ENABLED=false
CLOUD_COMPUTER_ENABLED=false
CLOUD_DELEGATION_ENABLED=true
CLOUD_EXPORT_ENABLED=true
CLOUD_WORKER_CONCURRENCY=3
# Retained account limits preserve stored configuration compatibility.
CLOUD_ACCOUNT_MODEL_CALL_LIMIT=100
CLOUD_ACCOUNT_CONCURRENCY=2
CLOUD_ACCOUNT_STORAGE_BYTES=104857600
CLOUD_REQUEST_LIMIT=20
CLOUD_EXECUTION_GATEWAY_URL=http://localhost:3002
CLOUD_WEB_URL=http://localhost:3000

# Private S3-compatible storage (required in production)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Development only: use the same absolute directory in API and Worker.
BLOB_STORAGE_DIR=

# Worker document conversion; container defaults include Chinese fonts.
SOFFICE_BINARY=
CLOUD_PDF_FONT_PATH=
CLOUD_PDF_FONT_FAMILY=NotoSansCJKsc-Regular
CLOUD_PPTX_FONT_FACE=Noto Sans CJK SC
PDFTOTEXT_BINARY=
PDFINFO_BINARY=

# Optional allowlisted telemetry; public values are compiled into Web.
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SITE_URL=http://localhost:3000
VITE_SUPPORT_EMAIL=
