NODE_ENV=development
# Enables the API's bounded expired-record cleanup every 15 minutes.
JOBS_ENABLED=false
# Apply pending foundation migrations before the API starts. Set false to manage them separately.
DATABASE_MIGRATE_ON_START=true
DATABASE_URL=postgres://raypx:raypx@localhost:5433/raypx_foundation
AUTH_URL=http://localhost:3002
AUTH_SECRET=raypx-development-only-secret-change-before-deployment
APP_KEY=raypx-development-only-app-key-change-before-deployment
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,views://main,raypx://
VITE_API_URL=http://localhost:3002
# Web/browser preview origin for verification and password-reset links.
# Installed Desktop uses ~/.raypx/config.toml instead of these VITE_* values.
VITE_WEB_URL=http://localhost:3000
# Parent domain shared by separately hosted Web and API, e.g. example.com.
# Set this to the shared parent when Web and API use sibling hosts.
AUTH_PASSKEY_RP_ID=
AUTH_CHECK_COMPROMISED_PASSWORDS=false
# Set both to protect requests for email sign-in codes.
AUTH_TURNSTILE_SITE_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_DOMAIN=
# Client IP for auth rate limits. Node uses the socket address unless you name the
# headers your trusted proxy writes (e.g. x-forwarded-for).
AUTH_IP_HEADERS=
# Proxy addresses/CIDRs to skip from the right of x-forwarded-for chains.
AUTH_TRUSTED_PROXIES=
# Optional cache and multi-node routing. Split api/relay roles require Redis.
# Optional shared cache/cluster broker. Combined backend works without it.
REDIS_URL=
SERVER_ROLE=both
# Optional session attachment storage is configured in PostgreSQL. See docs/development/object-storage.md.
# Authentication email is configured in PostgreSQL. See docs/development/configuration.md.

# Optional API error reports to PostHog error tracking (server-side, no user data).
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional browser diagnostics. Both categories remain off until the user opts in.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
# Root builds default VITE_APP_RELEASE to the current Git commit.
# RAYPX_SOURCEMAPS=1 enables hidden maps for an explicit release build.
# Source-map upload uses POSTHOG_CLI_HOST, POSTHOG_CLI_PROJECT_ID and
# secret POSTHOG_CLI_API_KEY in the release environment, never VITE_ variables.

# Comma-separated administrator emails. Accounts must verify their email first.
# Optional backend model directory and protected credential map (JSON).
# See docs/architecture/execution.md; both may stay empty to disable model access.
AGENT_MODELS=[]
AGENT_MODEL_CREDENTIALS={}
ADMIN_EMAILS=

# Optional social login: configure both values for each provider. Secrets stay on API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional computers. Everything else starts with none; the backend never receives an Engine socket.
COMPUTER_PROVIDER=none
SANDBOX_SUPERVISOR_URL=
SANDBOX_SUPERVISOR_TOKEN=
COMPUTERS_PER_SPACE=1
COMPUTERS_PER_MEMBER=10
