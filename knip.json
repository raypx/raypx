{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [".agents/skills/**"],
  "workspaces": {
    ".": {
      "entry": ["deploy/manifests.ts", "deploy/sources.ts"],
      "ignoreDependencies": ["@raypx/testing", "turbo"],
      "ignoreBinaries": ["expo"]
    },
    "apps/api": {
      "entry": [
        "src/app/*.ts",
        "src/routers/openapi-assets.ts",
        "src/runtime/plugin.ts",
        "src/jobs/runtime/*.ts",
        "vite.app.config.ts",
        "tests/helpers/workspace-server.ts",
        "tests/fixtures/deployment.ts",
        "tests/types/*.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/routes/**/*.tsx",
        "tests/native/smoke/*.ts",
        "vite.app.config.ts",
        "scripts/host/*.ts",
        "tests/native/fixtures/*.ts",
        "e2e/**/*.spec.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "vite.app.config.ts",
        "e2e/**/*.spec.ts",
        "public/sw.js"
      ]
    },
    "apps/cli": {
      "entry": [
        "tests/smoke/*.ts",
        "tests/fixtures/**/*.{ts,mjs}",
        "scripts/*.ts",
        "drizzle.config.ts"
      ],
      "drizzle": false
    },
    "apps/storybook": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"]
    },
    "packages/dev-cli": {
      "entry": ["src/validation/commit-message.ts"]
    },
    "packages/email": {
      "entry": ["vite.app.config.ts"]
    },
    "packages/logger": {
      "entry": ["tests/types/*.ts"]
    },
    "packages/database": {
      "entry": ["drizzle.config.ts"],
      "drizzle": false
    },
    "e2e": {
      "entry": ["tests/**/*.ts"]
    },
    "infra/railway": {
      "entry": ["scripts/iac-preload.ts"]
    },
    "packages/runtime-node": {
      "entry": ["src/*.ts"]
    },
    "packages/i18n": {
      "entry": ["tests/types/*.ts"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "tests/mocks/*.{ts,tsx}"]
    }
  }
}
