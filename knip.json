{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["apps/**/*.{js,mjs,ts,tsx}", "packages/**/*.{js,mjs,ts,tsx}", "e2e/**/*.ts"],
  "ignoreFiles": [
    "**/*.d.ts",
    "**/*.gen.ts",
    "**/.output/**",
    "**/dist/**",
    "**/.hutch/**",
    "**/build/**",
    "**/artifacts/**"
  ],
  "workspaces": {
    "apps/api": {
      "entry": ["server/app/*.ts", "server/runtime/plugin.ts"]
    },
    "apps/desktop": {
      "entry": [
        "src/routes/**/*.tsx",
        "native/main.ts",
        "tests/native/smoke/scenario.ts",
        "electrobun.config.ts",
        "scripts/native/*.ts"
      ]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "entry": ["src/main.ts", "tests/smoke/*.ts"]
    },
    "packages/tooling": {
      "entry": ["src/cli.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "src/commands.ts", "drizzle.config.ts"]
    },
    "e2e": {
      "entry": ["tests/**/*.ts", "playwright.config.ts"]
    }
  }
}
