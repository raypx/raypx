{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [".agents/skills/**"],
  "workspaces": {
    ".": {
      "entry": ["deploy/manifests.ts", "deploy/sources.ts"],
      "ignoreDependencies": ["@raypx/testing"]
    },
    "apps/api": {
      "entry": [
        "server/app/*.ts",
        "server/runtime/plugin.ts",
        "server/jobs/runtime/*.ts",
        "vite.app.config.ts",
        "tests/helpers/control-server.ts",
        "tests/fixtures/deployment.ts",
        "tests/fixtures/relay-process.ts",
        "tests/fixtures/task-lifecycle-relay.ts",
        "tests/types/*.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/routes/**/*.tsx",
        "tests/native/smoke/*.ts",
        "vite.app.config.ts",
        "scripts/host/*.ts",
        "tests/native/fixtures/*.ts",
        "e2e/**/*.spec.ts",
        "perf/*.bench.ts",
        "perf/browser/main.tsx",
        "perf/browser/vite.app.config.ts"
      ]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "vite.app.config.ts", "e2e/**/*.spec.ts"]
    },
    "apps/cli": {
      "entry": [
        "tests/smoke/*.ts",
        "tests/fixtures/**/*.{ts,mjs}",
        "perf/*.bench.ts",
        "scripts/*.ts"
      ]
    },
    "apps/storybook": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"]
    },
    "packages/dev-cli": {
      "entry": ["src/validation/commit-message.ts"]
    },
    "packages/email": {
      "entry": ["vite.app.config.ts"]
    },
    "packages/logger": {
      "entry": ["tests/types/*.ts"]
    },
    "packages/database": {
      "entry": ["drizzle.config.ts"],
      "drizzle": false
    },
    "e2e": {
      "entry": ["tests/**/*.ts"]
    },
    "infra/railway": {
      "entry": ["scripts/iac-preload.ts"]
    },
    "infra/cloudflare": {
      "entry": ["src/index.ts", "vite.app.config.ts"]
    },
    "packages/runtime-node": {
      "entry": ["src/*.ts"]
    },
    "packages/i18n": {
      "entry": ["tests/types/*.ts"]
    }
  }
}
