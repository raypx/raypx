{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["apps/**/*.{js,mjs,ts,tsx}", "packages/**/*.{js,mjs,ts,tsx}", "e2e/**/*.ts"],
  "ignoreFiles": [
    "**/*.d.ts",
    "**/*.gen.ts",
    "**/.output/**",
    "**/dist/**",
    "**/build/**",
    "**/artifacts/**",
    ".agents/skills/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["deploy/manifests.ts"],
      "ignoreDependencies": ["skills"]
    },
    "apps/api": {
      "entry": [
        "server/app/*.ts",
        "server/runtime/plugin.ts",
        "server/jobs/runtime/*.ts",
        "vite.app.config.ts",
        "tests/helpers/control-server.ts",
        "tests/types/*.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/routes/**/*.tsx",
        "tests/native/smoke/*.ts",
        "vite.app.config.ts",
        "scripts/native/*.ts",
        "tests/native/fixtures/*.ts"
      ]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "vite.app.config.ts"]
    },
    "apps/cli": {
      "entry": ["src/main.ts", "tests/smoke/*.ts", "tests/fixtures/**/*.{ts,mjs}"]
    },
    "apps/storybook": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"]
    },
    "packages/tooling": {
      "entry": ["src/cli.ts", "src/tasks/leaf.ts"]
    },
    "packages/email": {
      "entry": ["vite.app.config.ts"]
    },
    "packages/logger": {
      "entry": ["tests/types/*.ts"]
    },
    "packages/database": {
      "entry": ["src/index.ts", "src/commands.ts", "drizzle.config.ts"],
      "drizzle": false
    },
    "e2e": {
      "entry": [
        "tests/**/*.ts",
        "playwright.config.ts",
        "playwright.live.config.ts",
        "playwright.devtools.config.ts"
      ]
    }
  }
}
