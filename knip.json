{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["apps/**/*.{js,mjs,ts,tsx}", "packages/**/*.{js,mjs,ts,tsx}", "e2e/**/*.ts"],
  "ignoreFiles": [
    "**/*.d.ts",
    "**/*.gen.ts",
    "**/.output/**",
    "**/dist/**",
    "**/.hutch/**",
    "**/build/**",
    "**/artifacts/**"
  ],
  "workspaces": {
    "apps/api": {
      "entry": ["server/app.ts", "server/runtime.plugin.ts"]
    },
    "apps/desktop": {
      "entry": ["src/routes/**/*.tsx", "native/main.ts", "native/smoke.ts", "electrobun.config.ts"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "metro.config.cjs"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "entry": ["src/main.ts", "src/build.ts", "src/smoke.ts"]
    },
    "packages/tooling": {
      "entry": ["src/cli.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "src/commands.ts", "drizzle.config.ts"]
    },
    "e2e": {
      "entry": ["tests/**/*.ts", "playwright.config.ts"]
    }
  }
}
