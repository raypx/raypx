{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rpx env -- node scripts/dev.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "smoke": "node dist/index.mjs --check"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@raypx/ai": "workspace:*",
    "@raypx/application": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/db": "workspace:*",
    "@raypx/mail": "workspace:*",
    "@raypx/shared": "workspace:*",
    "@raypx/storage": "workspace:*",
    "@sentry/node": "catalog:backend",
    "exceljs": "catalog:backend",
    "pdfkit": "catalog:backend",
    "pptxgenjs": "catalog:backend"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@types/pdfkit": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "esbuild": "catalog:tooling"
  }
}
