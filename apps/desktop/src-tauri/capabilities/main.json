{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the owned local main view can use the native bridge.",
  "local": true,
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "allow-desktop-request",
    "allow-desktop-subscribe",
    "allow-desktop-unsubscribe",
    "allow-desktop-acknowledge"
  ]
}
