{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raypx",
  "version": "0.1.0",
  "identifier": "com.raypx.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/client",
    "beforeDevCommand": "bun --bun vp dev --config vite.app.config.ts"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["../resources/icon.png", "../resources/icon.ico"],
    "resources": {
      "../resources/bin/": "bin/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "../resources/Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
