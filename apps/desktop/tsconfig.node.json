{
  "extends": "@raypx-kit/tsconfig/node.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "types": ["bun", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vite.app.config.ts",
    "scripts/**/*.ts",
    "tests/scripts/**/*.ts",
    "tests/native/**/*.ts"
  ]
}
