{
  "extends": "@raypx/tsconfig/node.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "types": ["bun", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "vitest.config.ts",
    "preferences.test.ts",
    "vite.app.config.ts",
    "mygo.config.ts",
    "scripts/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/native/**/*.ts",
    "e2e/**/*.ts"
  ]
}
