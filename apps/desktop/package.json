{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#messages": "./locales/index.ts"
  },
  "scripts": {
    "dev": "bun run scripts/host/task.ts dev",
    "build": "bun run scripts/host/task.ts build",
    "preview": "raypx-dev env -- bun --bun vp preview --config vite.app.config.ts",
    "check": "bun run scripts/host/task.ts check",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:node": "tsc --noEmit --project tsconfig.node.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:component": "bun --bun vitest run --project component",
    "test:integration": "bun --bun vitest run --project integration",
    "test:coverage": "bun --bun vitest run --coverage",
    "native:dev": "bun run scripts/host/task.ts dev",
    "native:build": "bun run scripts/host/task.ts native:build",
    "native:csp": "bun scripts/host/csp.ts",
    "native:smoke": "bun run scripts/host/task.ts native:smoke",
    "native:smoke:interactive": "bun run scripts/host/task.ts native:smoke:interactive",
    "native:agents": "bun run scripts/host/task.ts native:agents",
    "build:renderer": "bun run scripts/host/task.ts build:renderer",
    "native:prepare": "bun scripts/host/mygo.ts prepare",
    "mygo:build": "bun scripts/host/mygo.ts build",
    "mygo:check": "bun scripts/host/mygo.ts check",
    "mygo:check:docker": "docker buildx build --file Dockerfile --target checks --output type=cacheonly ../..",
    "mygo:test": "bun run native:generate && bun scripts/host/mygo.ts test",
    "mygo:smoke": "bun scripts/host/mygo.ts smoke",
    "mygo:dev": "bun scripts/host/mygo.ts dev",
    "native:generate": "bun scripts/host/generate.ts",
    "e2e": "raypx-dev e2e",
    "perf": "bun perf/run.ts",
    "perf:check": "tsc --noEmit --project perf/tsconfig.json",
    "build:perf": "bun --bun vp build --config perf/browser/vite.app.config.ts"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/analytics": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/blocks": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "@raypx/tasks": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@hona/strobe": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@raypx/dev-cli": "workspace:*",
    "@raypx/devtools": "workspace:*",
    "@raypx/e2e": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/devtools": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "raypx": {
    "bundledDependencies": [
      "@raypx/devtools"
    ],
    "browserTestProject": "desktop"
  }
}
