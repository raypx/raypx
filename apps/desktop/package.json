{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/host/task.ts dev",
    "build": "tsx scripts/host/task.ts build",
    "preview": "raypx-dev env -- vp preview --config vite.app.config.ts",
    "check": "tsx scripts/host/task.ts check",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:node": "tsc --noEmit --project tsconfig.node.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --project unit",
    "test:component": "vp test --run --project component",
    "test:integration": "vp test --run --project integration",
    "test:coverage": "vp test --run --coverage",
    "native:dev": "tsx scripts/host/task.ts dev",
    "native:build": "tsx scripts/host/task.ts native:build",
    "native:csp": "tsx scripts/host/csp.ts",
    "native:smoke": "tsx scripts/host/task.ts native:smoke",
    "native:smoke:interactive": "tsx scripts/host/task.ts native:smoke:interactive",
    "native:agents": "tsx scripts/host/task.ts native:agents",
    "build:renderer": "tsx scripts/host/task.ts build:renderer",
    "native:prepare": "tsx scripts/host/tauri.ts prepare",
    "tauri:build": "tsx scripts/host/tauri.ts build",
    "tauri:check": "tsx scripts/host/tauri.ts check",
    "tauri:check:docker": "raypx-dev tasks desktop#tauri:check:docker --",
    "_tauri:check:docker": "pnpm run native:generate && docker buildx build --file Dockerfile --target checks --output type=cacheonly ../..",
    "tauri:test": "pnpm run native:generate && tsx scripts/host/tauri.ts test",
    "tauri:smoke": "tsx scripts/host/tauri.ts smoke",
    "tauri:dev": "tsx scripts/host/tauri.ts dev",
    "native:generate": "tsx scripts/host/generate.ts",
    "e2e": "raypx-dev e2e",
    "_e2e": "raypx-dev browser:run"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/analytics": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/blocks": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/jobs-model": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/memory-model": "workspace:*",
    "@raypx/tasks": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@playwright/test": "catalog:dev",
    "@raypx/devtools": "workspace:*",
    "@raypx/e2e": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:dev",
    "@tauri-apps/cli": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@types/semver": "catalog:dev",
    "@vitejs/devtools": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "semver": "catalog:",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "browser",
    "bundledDependencies": [
      "@raypx/devtools"
    ],
    "sourceTargets": {
      "tests/native/**": "node",
      "tests/integration/**": "node",
      "preferences.ts": "universal",
      "api.ts": "universal",
      "config.ts": "universal",
      "scripts/**": "node",
      "vite.app.config.ts": "node",
      "bridge.ts": "universal",
      "e2e/**": "node"
    },
    "taskScripts": {
      "e2e": "_e2e",
      "tauri:check:docker": "_tauri:check:docker"
    },
    "browserTestProject": "desktop"
  }
}
