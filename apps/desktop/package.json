{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/native/task.ts dev",
    "build": "bun run scripts/native/task.ts build",
    "preview": "raypx-dev env -- bun --bun vp preview --config vite.app.config.ts",
    "check": "bun run scripts/native/task.ts check",
    "typecheck": "bun --check --tsconfig-override tsconfig.json",
    "typecheck:node": "bun --check --tsconfig-override tsconfig.node.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run tests/renderer/unit tests/native tests/scripts --exclude \"**/integration/**\"",
    "test:component": "bun --bun vp test --run tests/renderer/component",
    "test:coverage": "bun --bun vp test --run --coverage",
    "native:dev": "bun run scripts/native/task.ts dev",
    "native:build": "bun run scripts/native/task.ts native:build",
    "native:csp": "bun scripts/native/csp.ts",
    "native:smoke": "bun run scripts/native/task.ts native:smoke",
    "native:smoke:interactive": "bun run scripts/native/task.ts native:smoke:interactive",
    "native:agents": "bun run scripts/native/task.ts native:agents",
    "native:beta": "bun run scripts/native/task.ts native:beta",
    "build:renderer": "bun run scripts/native/task.ts build:renderer",
    "native:prepare": "bun scripts/native/mygo.ts prepare",
    "mygo:build": "bun scripts/native/mygo.ts build",
    "mygo:check": "bun scripts/native/mygo.ts check",
    "mygo:test": "bun run native:generate && bun scripts/native/mygo.ts test",
    "mygo:smoke": "bun scripts/native/mygo.ts smoke",
    "mygo:dev": "bun scripts/native/mygo.ts dev",
    "native:generate": "bun scripts/native/generate.ts"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/analytics": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/blocks": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/tasks": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/devtools": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@tailwindcss/vite": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/devtools": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "browser",
    "bundledDependencies": [
      "@raypx/devtools"
    ],
    "sourceTargets": {
      "tests/native/**": "bun",
      "preferences.ts": "universal",
      "api.ts": "universal",
      "config.ts": "universal",
      "scripts/**": "bun",
      "tests/scripts/**": "bun",
      "vite.app.config.ts": "bun",
      "mygo.config.ts": "bun",
      "bridge.ts": "universal"
    }
  }
}
