{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/native/task.ts dev",
    "build": "bun run scripts/native/task.ts build",
    "preview": "raypx-dev env -- bun --bun vp preview",
    "check": "bun run scripts/native/task.ts check",
    "typecheck": "bun --check --tsconfig-override tsconfig.json",
    "typecheck:node": "bun --check --tsconfig-override tsconfig.node.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component/**' --exclude '**/integration/**'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration/",
    "test:component": "bun --bun vp test --run --passWithNoTests component/",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "native:dev": "bun run native:cli && bun --bun electrobun dev",
    "native:build": "bun run scripts/native/prepare-cli.ts --release && bun --bun electrobun build --env=stable",
    "native:prepare": "bun --bun electrobun prepare && bun run native:types",
    "typecheck:native": "bun --check --tsconfig-override tsconfig.native.json",
    "native:types": "bun --bun tsc --ignoreConfig --noCheck --declaration --emitDeclarationOnly --module ESNext --moduleResolution Bundler --target ES2022 --rootDir .hutch/devkit/api --outDir .hutch/types .hutch/devkit/api/sdks/main/entries/browser-view.ts .hutch/devkit/api/sdks/main/entries/browser-window.ts .hutch/devkit/api/sdks/main/entries/tray.ts .hutch/devkit/api/sdks/main/entries/updater.ts .hutch/devkit/api/sdks/main/entries/utils.ts .hutch/devkit/api/sdks/main/entries/rpc.ts .hutch/devkit/api/sdks/main/entries/build-config.ts .hutch/devkit/api/sdks/main/entries/events.ts",
    "native:cli": "bun run scripts/native/prepare-cli.ts",
    "native:smoke": "bun run native:cli && bun run tests/native/smoke/run.ts"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "electrobun": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@tailwindcss/vite": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "jsdom": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "browser",
    "sourceTargets": {
      "native/**": "bun",
      "tests/native/**": "bun",
      "preferences.ts": "universal",
      "scripts/**": "bun",
      "tests/scripts/**": "bun"
    }
  }
}
