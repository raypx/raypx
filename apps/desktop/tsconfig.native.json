{
  "extends": "@raypx-kit/tsconfig/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun", "node"],
    "resolveJsonModule": true,
    "paths": {
      "electrobun/rpc": ["./.hutch/types/sdks/main/entries/rpc.d.ts"],
      "electrobun/main/browser-view": ["./.hutch/types/sdks/main/entries/browser-view.d.ts"],
      "electrobun/main/browser-window": ["./.hutch/types/sdks/main/entries/browser-window.d.ts"],
      "electrobun/main/tray": ["./.hutch/types/sdks/main/entries/tray.d.ts"],
      "electrobun/main/updater": ["./.hutch/types/sdks/main/entries/updater.d.ts"],
      "electrobun/main/utils": ["./.hutch/types/sdks/main/entries/utils.d.ts"],
      "electrobun/main/build-config": ["./.hutch/types/sdks/main/entries/build-config.d.ts"],
      "electrobun/main/events": ["./.hutch/types/sdks/main/entries/events.d.ts"]
    }
  },
  "include": ["native/**/*.ts", "tests/native/**/*.ts", "scripts/**/*.ts", "tests/scripts/**/*.ts"]
}
