{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun --bun expo start",
    "check": "bun --bun uniwind generate-artifacts --css global.css --dts uniwind-types.d.ts && bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "doctor": "bun run scripts/doctor.ts",
    "bundle": "bun --bun expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@raypx/auth": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:dev",
    "@types/react": "catalog:dev",
    "expo-doctor": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "native",
    "sourceTargets": {
      "scripts/**": "node"
    }
  }
}
