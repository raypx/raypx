{
  "expo": {
    "name": "Raypx",
    "slug": "raypx",
    "scheme": "raypx",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raypx.mobile"
    },
    "android": {
      "package": "com.raypx.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
