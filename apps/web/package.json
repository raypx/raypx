{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "raypx-dev env -- bun --bun vp dev --config vite.app.config.ts",
    "build": "raypx-dev env -- bun --bun vp build --config vite.app.config.ts",
    "preview": "raypx-dev env -- bun --bun vp preview --config vite.app.config.ts",
    "start": "bun .output/server/index.mjs",
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run --passWithNoTests",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component/**' --exclude '**/integration/**'",
    "test:component": "bun --bun vp test --run --passWithNoTests component/",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/analytics": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/blocks": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/tasks": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "lucide-react": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/contracts": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@tailwindcss/vite": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "browser",
    "sourceTargets": {
      "vite.app.config.ts": "node"
    }
  }
}
