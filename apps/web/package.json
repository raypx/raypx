{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "raypx-dev env -- bun --bun vp dev --config vite.app.config.ts",
    "build": "raypx-dev env -- bun --bun vp build --config vite.app.config.ts",
    "_build": "bun --bun vp build --config vite.app.config.ts",
    "preview": "raypx-dev env -- bun --bun vp preview --config vite.app.config.ts",
    "start": "bun .output/server/index.mjs",
    "check": "bun --check --tsconfig-override tsconfig.json && bun --check --tsconfig-override e2e/tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --project unit",
    "test:component": "bun --bun vp test --run --project component",
    "test:coverage": "bun --bun vp test --run --coverage",
    "e2e": "raypx-dev e2e",
    "_e2e": "raypx-dev browser:run",
    "build:e2e": "raypx-dev tasks web#build:e2e"
  },
  "dependencies": {
    "@raypx/account": "workspace:*",
    "@raypx/analytics": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/blocks": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/icons": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/tasks": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@raypx/devtools": "workspace:*",
    "@raypx/e2e": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:dev",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/devtools": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "browser",
    "bundledDependencies": [
      "@raypx/devtools"
    ],
    "taskScripts": {
      "build": "_build",
      "e2e": "_e2e",
      "build:e2e": "_build"
    },
    "sourceTargets": {
      "vite.app.config.ts": "node",
      "e2e/**": "bun"
    },
    "browserTestProject": "web"
  }
}
