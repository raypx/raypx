{
  "name": "@voidmix/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vmx env -- vp dev --port 3000",
    "build": "vmx env -- vp build",
    "start": "node --enable-source-maps .output/server/index.mjs",
    "preview": "vmx env -- vp preview",
    "bundle:analyze": "bun run scripts/analyze-bundle.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run --passWithNoTests",
    "test:unit": "vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "vp test --run --passWithNoTests integration.test",
    "test:component": "vp test --run --passWithNoTests component.test",
    "test:coverage": "vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:frontend",
    "@sentry/react": "catalog:frontend",
    "@tanstack/react-query": "catalog:frontend",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:frontend",
    "@tanstack/react-start": "catalog:",
    "@voidmix/agent-ui": "workspace:*",
    "@voidmix/client": "workspace:*",
    "@voidmix/contracts": "workspace:*",
    "@voidmix/i18n": "workspace:*",
    "@voidmix/shared": "workspace:*",
    "@voidmix/ui": "workspace:*",
    "better-auth": "catalog:",
    "posthog-js": "catalog:frontend",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:frontend"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:tooling",
    "@testing-library/react": "catalog:tooling",
    "@testing-library/user-event": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@types/react-dom": "catalog:tooling",
    "@vitejs/plugin-react": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@voidmix/tsconfig": "workspace:*",
    "jsdom": "catalog:tooling",
    "nitro": "catalog:backend",
    "oxc-transform-react": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  }
}
