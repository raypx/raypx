{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rpx env -- bun --bun vp dev --port 3000",
    "build": "rpx env -- bun --bun vp build",
    "start": "bun --no-env-file --no-install .output/server/index.mjs",
    "preview": "rpx env -- bun --bun vp preview",
    "bundle:analyze": "bun run scripts/analyze-bundle.ts",
    "check": "bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun --bun vp test --run --passWithNoTests",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov"
  },
  "dependencies": {
    "@phosphor-icons/react": "catalog:frontend",
    "@raypx/agent-ui": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/i18n": "workspace:*",
    "@raypx/shared": "workspace:*",
    "@raypx/ui": "workspace:*",
    "@sentry/react": "catalog:frontend",
    "@tanstack/react-query": "catalog:frontend",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:frontend",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "posthog-js": "catalog:frontend",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@raypx/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "catalog:tooling",
    "@testing-library/react": "catalog:tooling",
    "@testing-library/user-event": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@types/react-dom": "catalog:tooling",
    "@vitejs/plugin-react": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "jsdom": "catalog:tooling",
    "nitro": "catalog:backend",
    "oxc-transform-react": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  }
}
