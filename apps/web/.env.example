# Runtime configuration is validated before accepting production requests.
# Copy to apps/web/.env. Development listening uses 127.0.0.1:5173.
# Blank values count as unset and use defaults or omit optional fields.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Optional Nitro listener overrides take precedence over HOST and PORT.
# NITRO_HOST=0.0.0.0
# NITRO_PORT=3000

# Optional server logging and release metadata.
# LOG_LEVEL=info
# APP_VERSION=0.1.0

# Containers: use HOST=0.0.0.0. Production: use NODE_ENV=production.
# Provider credentials must stay server-side without a VITE_ prefix.

# Optional account capability. Run bun run db:migrate before enabling it.
AUTH_ENABLED=false
# DATABASE_PATH=./data/raypx.db
# BETTER_AUTH_URL=http://127.0.0.1:5173
# BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
# Production requires an HTTPS BETTER_AUTH_URL.
# APP_ORIGIN=https://your-public-origin.example

# Opt-in Prometheus endpoint, authenticated with Authorization: Bearer <token>.
METRICS_ENABLED=false
# METRICS_TOKEN=generate-a-random-token-with-at-least-32-characters

# API quota is shared anonymously within one process, excluding probes and metrics.
# Inject a trusted identity resolver/shared limiter for multi-user or multi-instance use.
# API_RATE_LIMIT_MAX=120
# API_RATE_LIMIT_WINDOW_MS=60000

# Bounded auth body reads; pass the same policy to feature JSON handlers.
# Count actual bytes; timeout covers reading, not the entire request lifecycle.
# API_BODY_MAX_BYTES=1048576
# API_BODY_TIMEOUT_MS=10000
