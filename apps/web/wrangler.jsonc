{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raypx-web",
  "main": "./.output-cloudflare/server/index.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output-cloudflare/public",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.png"],
  },
}
