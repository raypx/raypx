{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:bootstrap-admins": "tsx server/administration/bootstrap.ts",
    "dev": "vp dev --config vite.app.config.ts",
    "start": "node .output/server/index.mjs",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:integration": "vp test --run tests/integration",
    "test:coverage": "vp test --run --coverage",
    "build": "vp build --config vite.app.config.ts",
    "test:postgres": "vp test --run --mode postgres",
    "test:redis": "vp test --run --mode redis",
    "test:cluster": "vp test --run --mode cluster",
    "deployment:fixture": "node artifacts/fixture/deployment.mjs",
    "build:fixture": "vp pack"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@orpc/evlog": "catalog:",
    "@orpc/server": "catalog:",
    "@raypx/account": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/control": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/email": "workspace:*",
    "@raypx/env": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/logger": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/storage": "workspace:*",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "nitro": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/client": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "node",
    "sourceTargets": {
      "vite.app.config.ts": "node"
    }
  }
}
