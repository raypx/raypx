{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:bootstrap-admins": "bun server/administration/bootstrap.ts",
    "storage:configure": "bun server/storage/configure.ts",
    "mail:configure": "bun server/configuration/configure-resend.ts",
    "dev": "bun --bun vp dev --config vite.app.config.ts",
    "start": "bun .output/server/index.mjs",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vitest run tests/integration",
    "test:coverage": "bun --bun vitest run --coverage",
    "build": "bun --bun vp build --config vite.app.config.ts",
    "test:postgres": "bun --bun vitest run --mode postgres",
    "test:redis": "bun --bun vitest run --mode redis",
    "test:cluster": "bun --bun vitest run --mode cluster",
    "deployment:fixture:build": "bun --no-env-file build tests/fixtures/deployment.ts --target=bun --format=esm --minify --packages=bundle --env=disable"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@orpc/evlog": "catalog:",
    "@orpc/server": "catalog:",
    "@raypx/account": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/control": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/email": "workspace:*",
    "@raypx/env": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/logger": "workspace:*",
    "@raypx/memory": "workspace:*",
    "@raypx/storage": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "lodash-es": "catalog:",
    "nitro": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@raypx/client": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/lodash-es": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
