{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun vp dev",
    "start": "node .output/server/index.mjs",
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests tests/unit",
    "test:integration": "bun --bun vp test --run --passWithNoTests tests/integration",
    "test:component": "bun --bun vp test --run --passWithNoTests component/",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "bun vp build",
    "test:postgres": "bun --bun vp test --run --mode postgres",
    "build:cloudflare": "bun vp build --mode cloudflare",
    "preview:cloudflare": "wrangler dev --config wrangler.jsonc --local",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "test:cloudflare:postgres": "bun --bun vp test --run --mode cloudflare-postgres",
    "test:redis": "bun --bun vp test --run --mode redis"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@orpc/evlog": "catalog:",
    "@orpc/server": "catalog:",
    "@raypx-kit/env": "catalog:",
    "@raypx-kit/logger": "catalog:",
    "@raypx/account": "workspace:*",
    "@raypx/auth": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/database": "workspace:*",
    "@raypx/mail": "workspace:*",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "nitro": "catalog:"
  },
  "devDependencies": {
    "@raypx-kit/tsconfig": "catalog:dev",
    "@raypx/client": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "raypx": {
    "kind": "app",
    "target": "node"
  }
}
