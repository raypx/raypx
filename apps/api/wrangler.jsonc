{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raypx-api",
  "main": "./.output-cloudflare/server/index.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "durable_objects": { "bindings": [{ "name": "RAYPX_RELAY", "class_name": "RelayRoom" }] },
  "migrations": [{ "tag": "relay-v1", "new_sqlite_classes": ["RelayRoom"] }],
  "vars": {
    "NODE_ENV": "production",
  },
}
