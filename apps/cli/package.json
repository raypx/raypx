{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "raypx": "./dist/main.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "check": "tsx scripts/generate-sqlite.ts --check && tsc --noEmit --project tsconfig.json",
    "test": "vp test --run",
    "test:unit": "vp test --run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:integration": "vp test --run tests/integration",
    "build": "tsx scripts/generate-sqlite.ts --check && vp pack",
    "smoke": "tsx tests/smoke/artifact.ts",
    "smoke:tui": "tsx tests/smoke/tui.ts",
    "smoke:herdr-terminal": "tsx tests/smoke/herdr-terminal.ts",
    "prepare:herdr": "tsx scripts/prepare-herdr.ts",
    "smoke:terminal": "tsx tests/smoke/terminal-hooks.ts",
    "smoke:terminal-stream": "tsx tests/smoke/terminal-stream.ts",
    "smoke:daemon-agents": "tsx tests/smoke/daemon-agents.ts",
    "smoke:pi": "tsx tests/smoke/pi-runner.ts",
    "perf:tasks": "vp test --run tests/integration/runtime/agents/snapshot --reporter=verbose --silent=false",
    "eval:agents": "tsx tests/evals/run.ts",
    "db:generate": "tsx scripts/generate-sqlite.ts"
  },
  "dependencies": {
    "@raypx/ai": "workspace:*",
    "@raypx/client": "workspace:*",
    "@raypx/contracts": "workspace:*",
    "@raypx/core": "workspace:*",
    "@raypx/instances": "workspace:*",
    "@raypx/jobs": "workspace:*",
    "@raypx/logger": "workspace:*",
    "@raypx/memory-model": "workspace:*",
    "@raypx/memory-server": "workspace:*",
    "@raypx/providers": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "citty": "catalog:",
    "confbox": "catalog:",
    "croner": "catalog:",
    "drizzle-orm": "catalog:",
    "semver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/node": "catalog:dev",
    "@types/semver": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "drizzle-kit": "catalog:dev",
    "tsx": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "herdr": {
    "version": "0.9.5",
    "assets": {
      "darwin-arm64": {
        "name": "herdr-macos-aarch64",
        "sha256": "fb77c2232a05a8035421382c894392f4174e4e38a18e48af3dd0290157c3a7e2"
      },
      "darwin-x64": {
        "name": "herdr-macos-x86_64",
        "sha256": "5fb0a908ec7f6745e3e245738b06bfad56c46391c391ab3c0955fbead01f1369"
      },
      "linux-arm64": {
        "name": "herdr-linux-aarch64",
        "sha256": "17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c"
      },
      "linux-x64": {
        "name": "herdr-linux-x86_64",
        "sha256": "14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d"
      },
      "win32-x64": {
        "name": "herdr-windows-x86_64.zip",
        "sha256": "d2c6c9c971c43a0bfdde8c692a9a1a7a45c3e4807cd01ae45662b4734fac1cbf"
      }
    }
  },
  "raypx": {
    "kind": "app",
    "target": "node"
  }
}
