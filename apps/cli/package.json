{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "check": "bun scripts/generate-sqlite.ts --check && tsc --noEmit --project tsconfig.json",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --exclude \"**/*.component.test.*\" --exclude \"**/tests/integration/**\"",
    "test:integration": "bun --bun vitest run tests/integration",
    "build": "bun scripts/generate-sqlite.ts --check && bun scripts/build.ts",
    "smoke": "bun run tests/smoke/artifact.ts",
    "db:generate": "bun scripts/generate-sqlite.ts"
  },
  "dependencies": {
    "@raypx/contracts": "workspace:*",
    "@raypx/logger": "workspace:*",
    "@raypx/runtime-node": "workspace:*",
    "citty": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@raypx/drizzle-kit": "workspace:*",
    "@raypx/testing": "workspace:*",
    "@raypx/tooling": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
