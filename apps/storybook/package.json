{
  "name": "ui-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir dist --quiet",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@raypx/icons": "workspace:*",
    "@raypx/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:dev"
  },
  "devDependencies": {
    "@raypx/task-graph": "workspace:*",
    "@raypx/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "catalog:dev",
    "@storybook/addon-docs": "catalog:dev",
    "@storybook/react-vite": "catalog:dev",
    "@tailwindcss/vite": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "vite": "catalog:dev"
  }
}
