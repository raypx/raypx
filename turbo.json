{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "cacheDir": ".turbo/cache",
  "concurrency": "4",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [
    "tsconfig.json",
    "vite.config.ts",
    "test.config.ts",
    "packages/tooling/src/testing/**",
    ".node-version",
    "bunfig.toml"
  ],
  "globalEnv": ["RAYPX_CACHE_PLATFORM", "CI", "LANG", "TZ"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["check", "^build", "transit"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["VITE_*", "NODE_ENV", "NITRO_PRESET"]
    },
    "api#build": {
      "dependsOn": ["check", "^build", "transit", "web#build"],
      "outputs": [".output/**"],
      "env": ["VITE_*", "NODE_ENV", "NITRO_PRESET"]
    },
    "desktop#build": {
      "dependsOn": ["check", "^build", "transit", "cli#build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "desktop#check": {
      "dependsOn": ["transit", "native:prepare"],
      "outputs": []
    },
    "native:prepare": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "VITE_*",
        "DATABASE_URL",
        "AUTH_*",
        "WEB_URL",
        "RESEND_API_KEY",
        "MAIL_*",
        "ALLOWED_ORIGINS",
        "NODE_ENV"
      ]
    },
    "desktop#dev": {
      "dependsOn": ["^build", "cli#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "NODE_ENV"]
    },
    "generate": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "NODE_ENV"]
    },
    "e2e": {
      "dependsOn": ["api#build", "desktop#build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["TEST_*", "NODE_ENV", "PLAYWRIGHT_*", "CI"]
    },
    "bundle": {
      "dependsOn": ["check", "^build", "transit"],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_*", "NODE_ENV"]
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:component": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:postgres": {
      "dependsOn": ["transit"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["TEST_DATABASE_URL", "NODE_ENV"]
    }
  }
}
