{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "agentGuidance": false,
  "cacheDir": ".turbo/cache",
  "concurrency": "4",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [
    "tsconfig.json",
    "vite.config.ts",
    "test.config.ts",
    "packages/tooling/tests/setup/**",
    ".nvmrc",
    "bunfig.toml"
  ],
  "globalEnv": ["RAYPX_CACHE_PLATFORM", "CI", "LANG", "TZ"],
  "tasks": {
    "//#lint": {
      "dependsOn": ["desktop#native:prepare"],
      "cache": false,
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["check", "^build", "transit"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["VITE_*", "NODE_ENV", "NITRO_PRESET", "RAYPX_SOURCEMAPS"]
    },
    "desktop#build": {
      "dependsOn": ["check", "^build", "transit", "cli#build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "NODE_ENV", "RAYPX_DESKTOP_BUILD_ARGS", "RAYPX_SOURCEMAPS"]
    },
    "desktop#check": {
      "dependsOn": ["transit", "native:prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "jit",
          "globs": [".hutch/devkit/**", ".hutch/types/**"]
        }
      ],
      "env": ["RAYPX_DESKTOP_CHECK_ARGS"],
      "outputs": []
    },
    "native:prepare": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "desktop#dev": {
      "dependsOn": ["^build", "cli#build", "native:prepare"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false,
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["web#build", "desktop#build"],
      "cache": false,
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["check", "^build", "transit"],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_*", "NODE_ENV"]
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "test:component": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "outputs": [],
      "env": ["NODE_ENV"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"],
      "cache": false
    },
    "test:postgres": {
      "dependsOn": ["transit"],
      "cache": false,
      "outputs": []
    },
    "test:redis": {
      "dependsOn": ["transit"],
      "cache": false,
      "outputs": []
    },
    "build:cloudflare": {
      "dependsOn": ["check", "^build", "transit"],
      "outputs": [".output-cloudflare/**"],
      "env": ["VITE_*", "NODE_ENV", "RAYPX_SOURCEMAPS"]
    },
    "test:cloudflare:postgres": {
      "dependsOn": ["transit", "build:cloudflare"],
      "cache": false,
      "outputs": []
    }
  }
}
